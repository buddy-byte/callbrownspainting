---
interface Props {
  city: string;
  county: string;
  state?: string;
  slug: string;          // e.g. 'brewton'
  heroImage?: string;
  nearbyLinks?: { name: string; url: string }[];
}

const {
  city,
  county,
  state = 'AL',
  slug,
  heroImage = '/images/hero/hero-1-optimized.jpg',
  nearbyLinks = [],
} = Astro.props;

const phone = '(251) 236-1411';
const phoneHref = 'tel:+12512361411';
---

<!-- ── HERO ── -->
<section class="lp-hero">
  <div class="lp-hero-bg" style={`background-image:url('${heroImage}')`}></div>
  <div class="lp-hero-overlay"></div>
  <div class="lp-hero-inner">
    <span class="lp-eyebrow">Serving {city}, {state}</span>
    <h1 class="lp-h1">Professional Painting Services<br/>in {city}, {state}</h1>
    <p class="lp-sub">Browns Painting — {county}'s trusted painting contractor since 1998. Family-owned, licensed, insured, and personally on every job.</p>
    <div class="lp-actions">
      <a href="/contact" class="lp-btn-primary">Get a Free Quote →</a>
      <a href={phoneHref} class="lp-btn-ghost">{phone}</a>
    </div>
    <div class="lp-pills">
      <span class="lp-pill">★★★★★ 5-Star Rated</span>
      <span class="lp-pill">25+ Years Experience</span>
      <span class="lp-pill">Licensed &amp; Insured</span>
      <span class="lp-pill">100% Satisfaction Guarantee</span>
    </div>
  </div>
</section>

<!-- ── STATS STRIP ── -->
<div class="lp-stats-strip">
  <div class="lp-stat"><strong>25+</strong><span>Years Experience</span></div>
  <div class="lp-stat"><strong>500+</strong><span>Projects Completed</span></div>
  <div class="lp-stat"><strong>3–7</strong><span>Day Turnaround</span></div>
  <div class="lp-stat"><strong>100%</strong><span>Satisfaction Guaranteed</span></div>
</div>

<!-- ── SERVICES ── -->
<section class="lp-section lp-cream">
  <div class="lp-container">
    <div class="lp-section-header">
      <span class="lp-eyebrow-sm">Our Services</span>
      <h2 class="lp-h2">Painting Services in {city}</h2>
      <p>From single rooms to full-home and commercial projects — we handle it all with the same level of care and quality.</p>
    </div>
    <div class="lp-services-grid">
      <a href="/interior-painting" class="lp-svc-card">
        <div class="lp-svc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
        </div>
        <h3>Interior Painting</h3>
        <p>Walls, ceilings, trim, cabinets. Flawless prep, premium paint, meticulous cleanup.</p>
        <span class="lp-svc-cta">Learn More →</span>
      </a>
      <a href="/exterior-painting" class="lp-svc-card">
        <div class="lp-svc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <h3>Exterior Painting</h3>
        <p>Weather-resistant coatings built for Alabama's heat, humidity, and storms.</p>
        <span class="lp-svc-cta">Learn More →</span>
      </a>
      <a href="/commercial-painting" class="lp-svc-card">
        <div class="lp-svc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18M2 22h20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>Commercial Painting</h3>
        <p>After-hours scheduling, minimal disruption, commercial-grade results.</p>
        <span class="lp-svc-cta">Learn More →</span>
      </a>
      <a href="/house-painter" class="lp-svc-card">
        <div class="lp-svc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.75"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <h3>Whole-Home Painting</h3>
        <p>Complete makeovers from a single room to your entire property.</p>
        <span class="lp-svc-cta">Learn More →</span>
      </a>
    </div>
  </div>
</section>

<!-- ── WHY BROWNS ── -->
<section class="lp-section lp-dark">
  <div class="lp-container">
    <div class="lp-section-header lp-header-white">
      <span class="lp-eyebrow-sm">Why Browns</span>
      <h2 class="lp-h2 lp-h2-white">Why {city} Homeowners<br/><em>Choose Browns Painting</em></h2>
    </div>
    <div class="lp-why-grid">
      <div class="lp-why-tile">
        <span class="lp-why-num">01</span>
        <h4>Owner on Every Job</h4>
        <p>Boomer personally oversees every project. You're not getting a sub-crew — you're getting the owner on-site.</p>
      </div>
      <div class="lp-why-tile">
        <span class="lp-why-num">02</span>
        <h4>25+ Years in South Alabama</h4>
        <p>We've been serving {county} homeowners and businesses since 1998. Our reputation is our most valuable asset.</p>
      </div>
      <div class="lp-why-tile">
        <span class="lp-why-num">03</span>
        <h4>Fast Turnaround</h4>
        <p>Most residential projects completed in 3–7 days. We show up when we say and finish when we say.</p>
      </div>
      <div class="lp-why-tile">
        <span class="lp-why-num">04</span>
        <h4>Licensed &amp; Fully Insured</h4>
        <p>Full Alabama licensing and liability coverage on every job. Your home is completely protected.</p>
      </div>
      <div class="lp-why-tile">
        <span class="lp-why-num">05</span>
        <h4>Premium Paints Only</h4>
        <p>Low-VOC, weather-resistant paints formulated for Alabama's climate. No budget materials, ever.</p>
      </div>
      <div class="lp-why-tile">
        <span class="lp-why-num">06</span>
        <h4>100% Satisfaction Guarantee</h4>
        <p>We don't call it done until you're completely happy. We'll come back and make it right — no questions asked.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── NEARBY ── -->
{nearbyLinks.length > 0 && (
  <section class="lp-section lp-cream">
    <div class="lp-container">
      <div class="lp-nearby-header">
        <span class="lp-eyebrow-sm">Also Serving</span>
        <h2 class="lp-h2">Nearby Areas We Serve</h2>
      </div>
      <div class="lp-nearby-grid">
        {nearbyLinks.map(link => (
          <a href={link.url} class="lp-nearby-link">{link.name}</a>
        ))}
        <a href="/service-areas" class="lp-nearby-link lp-nearby-all">All Service Areas →</a>
      </div>
    </div>
  </section>
)}

<!-- ── CTA ── -->
<section class="lp-cta-strip">
  <div class="lp-container lp-cta-inner">
    <div>
      <h2 class="lp-cta-h2">Ready for a Free Estimate<br/>in {city}?</h2>
      <p>Call Boomer directly or fill out the quick quote form. We respond within 24 hours.</p>
    </div>
    <div class="lp-cta-btns">
      <a href="/contact" class="lp-btn-primary" style="font-size:1rem;padding:1rem 2.25rem">Get a Free Quote →</a>
      <a href={phoneHref} class="lp-cta-phone">{phone}</a>
    </div>
  </div>
</section>

<style>
  .lp-container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  /* ── HERO ── */
  .lp-hero { position: relative; min-height: 55vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .lp-hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; filter: brightness(0.55) saturate(0.9); transform: scale(1.04); }
  .lp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(17,24,39,0.5) 0%, rgba(17,24,39,0.8) 100%); }
  .lp-hero-inner { position: relative; z-index: 2; max-width: 800px; margin: 0 auto; padding: 5rem 2rem 4rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .lp-eyebrow { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }
  .lp-h1 { font-family: var(--font-sans); font-size: clamp(1.875rem, 5vw, 3.5rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.08; color: #fff; margin: 0; }
  .lp-sub { font-family: var(--font-sans); font-size: 1.0625rem; color: rgba(255,255,255,0.65); line-height: 1.6; max-width: 580px; margin: 0; }
  .lp-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
  .lp-btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 2rem; background: var(--amber); color: var(--ink); font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); transition: background 0.2s, transform 0.2s; box-shadow: var(--shadow-amber); }
  .lp-btn-primary:hover { background: var(--amber-deep); transform: translateY(-2px); }
  .lp-btn-ghost { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.25); color: #fff; font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 700; text-decoration: none; border-radius: var(--radius-md); transition: background 0.2s; }
  .lp-btn-ghost:hover { background: rgba(255,255,255,0.18); }
  .lp-pills { display: flex; gap: 0.625rem; flex-wrap: wrap; justify-content: center; }
  .lp-pill { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 100px; padding: 0.3125rem 0.875rem; }

  /* ── STATS STRIP ── */
  .lp-stats-strip { background: var(--ink); display: grid; grid-template-columns: repeat(4, 1fr); }
  .lp-stat { padding: 1.75rem 1rem; text-align: center; display: flex; flex-direction: column; gap: 0.25rem; border-right: 1px solid rgba(255,255,255,0.06); }
  .lp-stat:last-child { border-right: none; }
  .lp-stat strong { font-family: var(--font-sans); font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; color: var(--amber); line-height: 1; }
  .lp-stat span { font-family: var(--font-sans); font-size: 0.625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); }

  /* ── SECTIONS ── */
  .lp-section { padding: 5rem 0 6rem; }
  .lp-cream { background: var(--cream); }
  .lp-dark { background: var(--ink-soft); }

  .lp-section-header { max-width: 640px; margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .lp-header-white { }
  .lp-eyebrow-sm { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }
  .lp-h2 { font-family: var(--font-sans); font-size: clamp(1.875rem, 4vw, 3rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.08; color: var(--ink); margin: 0; }
  .lp-h2-white { color: #fff; }
  .lp-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber); letter-spacing: -0.02em; }
  .lp-section-header p { font-family: var(--font-sans); font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  /* Services grid */
  .lp-services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }
  .lp-svc-card { background: var(--white); padding: 2rem 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; text-decoration: none; color: inherit; transition: background 0.2s; }
  .lp-svc-card:hover { background: #faf8f5; }
  .lp-svc-icon { width: 48px; height: 48px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--amber); }
  .lp-svc-card h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 800; color: var(--ink); margin: 0; letter-spacing: -0.02em; }
  .lp-svc-card p { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin: 0; }
  .lp-svc-cta { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 800; color: var(--amber); margin-top: auto; }

  /* Why grid */
  .lp-why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: rgba(255,255,255,0.06); border: 1.5px solid rgba(255,255,255,0.06); border-radius: var(--radius-xl); overflow: hidden; }
  .lp-why-tile { background: var(--ink-soft); padding: 2.25rem 2rem; display: flex; flex-direction: column; gap: 0.875rem; position: relative; }
  .lp-why-num { font-family: var(--font-sans); font-size: 0.625rem; font-weight: 900; letter-spacing: 0.1em; color: var(--amber); }
  .lp-why-tile h4 { font-family: var(--font-sans); font-size: 1rem; font-weight: 800; color: #fff; margin: 0; letter-spacing: -0.02em; }
  .lp-why-tile p { font-family: var(--font-sans); font-size: 0.875rem; color: rgba(255,255,255,0.45); line-height: 1.65; margin: 0; }

  /* Nearby */
  .lp-nearby-header { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .lp-nearby-grid { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .lp-nearby-link { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 700; color: var(--ink); text-decoration: none; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.5rem 1rem; transition: border-color 0.2s, color 0.2s; }
  .lp-nearby-link:hover { border-color: var(--amber); color: var(--amber-deep); }
  .lp-nearby-all { background: var(--ink); color: #fff; border-color: var(--ink); }
  .lp-nearby-all:hover { background: var(--ink-soft); color: var(--amber); border-color: var(--ink-soft); }

  /* CTA */
  .lp-cta-strip { background: var(--amber); padding: 4.5rem 0; }
  .lp-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .lp-cta-h2 { font-family: var(--font-sans); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.15; color: var(--ink); margin: 0 0 0.5rem; }
  .lp-cta-strip p { font-family: var(--font-sans); font-size: 1rem; color: rgba(17,24,39,0.65); margin: 0; }
  .lp-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .lp-cta-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: rgba(17,24,39,0.5); text-decoration: none; white-space: nowrap; }
  .lp-cta-phone:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .lp-services-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-why-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-cta-inner { flex-direction: column; text-align: center; }
    .lp-cta-btns { flex-direction: column; }
    .lp-stats-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .lp-services-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-why-grid { grid-template-columns: 1fr; }
    .lp-stats-strip { grid-template-columns: repeat(2, 1fr); }
    .lp-container { padding: 0 1.25rem; }
    .lp-actions { flex-direction: column; align-items: center; width: 100%; }
    .lp-btn-primary, .lp-btn-ghost { width: 100%; justify-content: center; max-width: 300px; }
    .lp-h1 { font-size: clamp(1.625rem, 7vw, 2.5rem); }
    .lp-hero-inner { padding: 4.5rem 1.25rem 3.5rem; }
    .lp-section { padding: 3.5rem 0 4rem; }
  }
</style>
