---

<section style="padding: 5rem 0; background: white;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
    <!-- Top Centered Header -->
    <div style="text-align: center; margin-bottom: 4rem;">
      <span style="display: inline-block; padding: 0.5rem 1.5rem; background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.1)); color: #3b82f6; font-weight: 700; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 1px; border-radius: 50px; margin-bottom: 1rem; border: 1px solid rgba(59, 130, 246, 0.2);">Portfolio</span>
      <h2 style="font-size: 3rem; font-weight: 900; color: #1f2937; margin-bottom: 1rem;">Our Recent Work</h2>
      <p style="font-size: 1.25rem; color: #6b7280; line-height: 1.6;">See the quality and attention to detail that sets Browns Painting apart</p>
    </div>
    
    <!-- Projects Grid - 3 Columns -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
      {projects.map(project => (
        <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); border: 2px solid #f3f4f6; transition: all 0.4s ease;">
          <div style="position: relative; height: 250px; overflow: hidden;">
            <img src={project.image} alt={project.title} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" />
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(transparent, rgba(0, 0, 0, 0.7)); display: flex; align-items: flex-end; padding: 1.5rem;">
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <span style="background: rgba(255, 255, 255, 0.9); padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.75rem; color: #374151; font-weight: 600;">{project.location}</span>
                <span style="background: rgba(255, 255, 255, 0.9); padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.75rem; color: #374151; font-weight: 600;">{project.service}</span>
              </div>
            </div>
          </div>
          
          <div style="padding: 1.5rem;">
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: #1f2937; font-weight: 700;">{project.title}</h3>
            <p style="color: #6b7280; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.9375rem;">{project.description}</p>
            
            {project.features && (
              <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem;">
                {project.features.map(feature => (
                  <li style="color: #10b981; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 500;">✓ {feature}</li>
                ))}
              </ul>
            )}
            
            {project.testimonial && (
              <blockquote style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #fbbf24; font-style: italic; color: #374151; margin: 0; font-size: 0.9375rem;">
                "{project.testimonial}"
                {project.customer && <cite style="display: block; margin-top: 0.5rem; font-style: normal; font-weight: 600; color: #6b7280; font-size: 0.875rem;">— {project.customer}</cite>}
              </blockquote>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project-gallery {
    padding: 4rem 0;
    background: white;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .project-gallery h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #333;
  }

  .section-subtitle {
    text-align: center;
    color: #6b7280;
    font-size: 1.125rem;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .project-image-container {
    position: relative;
    height: 250px;
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .project-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-meta span {
    background: rgba(255, 255, 255, 0.9);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
    color: #374151;
    font-weight: 600;
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: #1f2937;
    font-weight: 700;
  }

  .project-description {
    color: #6b7280;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .project-features {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .project-features li {
    color: #10b981;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .project-testimonial {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #f59e0b;
    font-style: italic;
    color: #374151;
    margin: 0;
  }

  .project-testimonial cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-weight: 600;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .project-image-container {
      height: 200px;
    }
    
    .project-content {
      padding: 1rem;
    }
    
    .project-content h3 {
      font-size: 1.125rem;
    }
    
    .project-meta {
      gap: 0.5rem;
    }
    
    .project-meta span {
      font-size: 0.7rem;
      padding: 0.2rem 0.6rem;
    }
  }
</style>