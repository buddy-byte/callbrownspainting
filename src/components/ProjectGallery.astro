---

<section class="gallery-section">
  <div class="gallery-container">
    <div class="gallery-grid">
      {projects.map(project => (
        <div class="gallery-card">
          <div class="gallery-card-img">
            <img src={project.image} alt={project.title} loading="lazy" />
            <div class="gallery-card-tags">
              <span class="gallery-tag">{project.location}</span>
              <span class="gallery-tag">{project.service}</span>
            </div>
          </div>
          <div class="gallery-card-body">
            <h3 class="gallery-card-title">{project.title}</h3>
            <p class="gallery-card-desc">{project.description}</p>

            {project.features && (
              <ul class="gallery-features">
                {project.features.map(feature => (
                  <li>{feature}</li>
                ))}
              </ul>
            )}
            
            {project.testimonial && (
              <blockquote class="gallery-quote">
                "{project.testimonial}"
                {project.customer && <cite class="gallery-cite">— {project.customer}</cite>}
              </blockquote>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    background: var(--cream);
    padding: 0 0 5rem;
  }

  .gallery-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .gallery-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .gallery-card-img {
    position: relative;
    height: 240px;
    overflow: hidden;
  }

  .gallery-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-card:hover .gallery-card-img img {
    transform: scale(1.04);
  }

  .gallery-card-tags {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.65));
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 1.25rem;
  }

  .gallery-tag {
    background: rgba(255,255,255,0.92);
    padding: 0.2rem 0.625rem;
    border-radius: 20px;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .gallery-card-body {
    padding: 1.5rem;
  }

  .project-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: #1f2937;
    font-weight: 700;
  }

  .project-description {
    color: #6b7280;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .project-features {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .gallery-card-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .gallery-card-desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .gallery-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .gallery-features li {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .gallery-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--amber);
  }

  .gallery-quote {
    background: var(--cream);
    padding: 1.125rem 1.25rem;
    border-radius: var(--radius-md);
    border-left: 3px solid var(--amber);
    font-style: italic;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  .gallery-cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .gallery-card-img { height: 200px; }
  }
</style>