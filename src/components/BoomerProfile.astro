---
---
<section class="bp-hero-section">
  <div class="container">
    <div class="bp-split">
      <div class="bp-img-col">
        <div class="bp-img-frame">
          <img src="/images/boomer-photos/boomer-1-optimized.jpg" alt="Barry 'Boomer' Brown, Owner" loading="eager" />
          <div class="bp-badge">
            <strong>25+</strong>
            <span>Years of Craft</span>
          </div>
        </div>
        <div class="bp-photo-row">
          <div class="bp-photo-card">
            <img src="/images/boomer-photos/boomer-2-optimized.jpg" alt="Boomer at work" loading="lazy" />
          </div>
          <div class="bp-photo-card">
            <img src="/images/boomer-photos/boomer-3-optimized.jpg" alt="Boomer with family" loading="lazy" />
          </div>
        </div>
      </div>

      <div class="bp-content-col">
        <span class="eyebrow">Meet the Owner</span>
        <h2 class="bp-h2">Barry <em>"Boomer"</em> Brown</h2>
        <p class="bp-title-label">Owner &amp; Lead Painter · Brewton, Alabama</p>

        <p class="bp-bio">Barry "Boomer" Brown has been serving South Alabama with professional painting services for over 25 years. Based in Brewton, Alabama, Boomer brings decades of expertise to every project — from single-room touch-ups to large commercial renovations. His commitment to quality has earned him a reputation as one of the most trusted painters in Conecuh, Escambia, and Baldwin Counties.</p>

        <blockquote class="bp-quote">
          "Every project deserves the same level of care — whether it's one room or a whole building. I show up personally on every job. That's my guarantee."
          <cite>— Barry "Boomer" Brown</cite>
        </blockquote>

        <div class="bp-creds">
          <div class="bp-cred">
            <div class="bp-cred-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <span>Licensed Painting Contractor</span>
          </div>
          <div class="bp-cred">
            <div class="bp-cred-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
            </div>
            <span>Fully Insured &amp; Bonded</span>
          </div>
          <div class="bp-cred">
            <div class="bp-cred-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.75"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <span>Alabama State Licensed</span>
          </div>
          <div class="bp-cred">
            <div class="bp-cred-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
            </div>
            <span>5-Star Google Rated</span>
          </div>
        </div>

        <div class="bp-actions">
          <a href="/contact" class="btn-amber">Get a Free Estimate →</a>
          <a href="tel:+12512361411" class="bp-phone">(251) 236-1411</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── FAMILY & CREW ── -->
<section class="bp-gallery-section">
  <div class="container">
    <div class="bp-gallery-header">
      <span class="eyebrow">Family &amp; Craft</span>
      <h2 class="bp-gallery-h2">South Alabama's <em>Painter.</em></h2>
      <p>Boomer believes in family values and passing down a love of quality craftsmanship — including to his grandson Brayden, who you'll sometimes find on the job site.</p>
    </div>
    <div class="bp-gallery-grid">
      <div class="bp-gallery-card bp-gallery-large">
        <img src="/images/boomer-photos/boomer-4-optimized.jpg" alt="Boomer Brown professional" loading="lazy" />
        <div class="bp-gallery-overlay">
          <span>25+ Years of Craft</span>
        </div>
      </div>
      <div class="bp-gallery-card">
        <img src="/images/boomer-photos/boomer-5-optimized.jpg" alt="Browns Painting crew" loading="lazy" />
        <div class="bp-gallery-overlay">
          <span>The Crew</span>
        </div>
      </div>
      <div class="bp-gallery-card">
        <img src="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg" alt="Exterior painting project" loading="lazy" />
        <div class="bp-gallery-overlay">
          <span>Our Work</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SPECIALTIES ── -->
<section class="bp-spec-section">
  <div class="container">
    <div class="bp-spec-header">
      <span class="eyebrow">What We Do Best</span>
      <h2 class="bp-spec-h2">Specialties &amp; <em>Services.</em></h2>
    </div>
    <div class="bp-spec-grid">
      <a href="/interior-painting" class="bp-spec-card">
        <div class="bp-spec-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
        </div>
        <h4>Interior Painting</h4>
        <p>Walls, ceilings, trim, cabinets. Flawless finishes, every time.</p>
        <span class="bp-spec-link">Learn More →</span>
      </a>
      <a href="/exterior-painting" class="bp-spec-card">
        <div class="bp-spec-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <h4>Exterior Painting</h4>
        <p>Weather-resistant coatings for Alabama's toughest conditions.</p>
        <span class="bp-spec-link">Learn More →</span>
      </a>
      <a href="/commercial-painting" class="bp-spec-card">
        <div class="bp-spec-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18M2 22h20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h4>Commercial Painting</h4>
        <p>After-hours scheduling. Minimal disruption. Commercial-grade results.</p>
        <span class="bp-spec-link">Learn More →</span>
      </a>
      <a href="/house-painter" class="bp-spec-card">
        <div class="bp-spec-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.75"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <h4>Color Consultation</h4>
        <p>Free color advice to find the perfect palette for your space.</p>
        <span class="bp-spec-link">Learn More →</span>
      </a>
    </div>
  </div>
</section>

<!-- ── CTA ── -->
<section class="bp-cta-strip">
  <div class="container bp-cta-inner">
    <div>
      <h2 class="bp-cta-h2">Ready to Work with Boomer?</h2>
      <p>Free estimates · Fast scheduling · 100% satisfaction guarantee</p>
    </div>
    <div class="bp-cta-btns">
      <a href="/contact" class="btn-amber">Get a Free Estimate →</a>
      <a href="tel:+12512361411" class="bp-cta-phone">(251) 236-1411</a>
    </div>
  </div>
</section>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  .eyebrow {
    display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber);
  }

  .btn-amber {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem;
    background: var(--amber); color: var(--ink); font-family: var(--font-sans);
    font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md);
    box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s;
  }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  /* ── HERO SECTION ── */
  .bp-hero-section { background: var(--cream); padding: 5.5rem 0 6rem; }

  .bp-split { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }

  .bp-img-col { display: flex; flex-direction: column; gap: 1rem; }

  .bp-img-frame { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 3/4; }
  .bp-img-frame img { width: 100%; height: 100%; object-fit: cover; filter: brightness(1.03) saturate(1.1); }

  .bp-badge {
    position: absolute; bottom: 1.5rem; right: 1.5rem;
    background: var(--amber); border-radius: var(--radius-md); padding: 0.875rem 1.125rem; text-align: center;
  }
  .bp-badge strong { display: block; font-family: var(--font-sans); font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--ink); }
  .bp-badge span { font-family: var(--font-sans); font-size: 0.625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(17,24,39,0.65); }

  .bp-photo-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .bp-photo-card { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; }
  .bp-photo-card img { width: 100%; height: 100%; object-fit: cover; }

  .bp-content-col { display: flex; flex-direction: column; gap: 1.25rem; padding-top: 0.5rem; }

  .bp-h2 { font-family: var(--font-sans); font-size: clamp(2.25rem, 4vw, 3.75rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }
  .bp-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber-deep); letter-spacing: -0.02em; }

  .bp-title-label { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: -0.25rem 0 0; }

  .bp-bio { font-family: var(--font-sans); font-size: 1.0625rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  .bp-quote {
    background: var(--white); border-radius: var(--radius-md); padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--amber); margin: 0;
    box-shadow: var(--shadow-sm);
  }
  .bp-quote p, .bp-quote { font-family: var(--font-display); font-style: italic; font-size: 1.0625rem; color: var(--ink); line-height: 1.6; }
  .bp-quote cite { display: block; margin-top: 0.75rem; font-family: var(--font-sans); font-style: normal; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); }

  .bp-creds { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .bp-cred { display: flex; align-items: center; gap: 0.75rem; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.75rem 1rem; }
  .bp-cred-icon { width: 34px; height: 34px; background: rgba(245,158,11,0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--amber); flex-shrink: 0; }
  .bp-cred span { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 700; color: var(--text); }

  .bp-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .bp-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: var(--text-muted); text-decoration: none; }
  .bp-phone:hover { color: var(--amber-deep); }

  /* ── GALLERY ── */
  .bp-gallery-section { background: var(--ink-soft); padding: 5rem 0 6rem; }
  .bp-gallery-header { max-width: 600px; margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .bp-gallery-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: #fff; margin: 0; }
  .bp-gallery-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber); }
  .bp-gallery-header p { font-family: var(--font-sans); font-size: 1rem; color: rgba(255,255,255,0.45); line-height: 1.7; margin: 0; }
  .bp-gallery-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1rem; }
  .bp-gallery-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; }
  .bp-gallery-large { aspect-ratio: unset; grid-row: span 1; }
  .bp-gallery-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .bp-gallery-card:hover img { transform: scale(1.04); }
  .bp-gallery-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 1rem 1.25rem; background: linear-gradient(to top, rgba(17,24,39,0.8), transparent); }
  .bp-gallery-overlay span { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.8); }

  /* ── SPECIALTIES ── */
  .bp-spec-section { background: var(--cream); padding: 5rem 0 6rem; }
  .bp-spec-header { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .bp-spec-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }
  .bp-spec-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber-deep); }
  .bp-spec-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }
  .bp-spec-card { background: var(--white); padding: 2rem 1.75rem; display: flex; flex-direction: column; gap: 0.75rem; text-decoration: none; color: inherit; transition: background 0.2s; }
  .bp-spec-card:hover { background: #faf8f5; }
  .bp-spec-icon { width: 48px; height: 48px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--amber); }
  .bp-spec-card h4 { font-family: var(--font-sans); font-size: 1.0625rem; font-weight: 800; color: var(--ink); margin: 0; letter-spacing: -0.02em; }
  .bp-spec-card p { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0; }
  .bp-spec-link { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 800; color: var(--amber); margin-top: auto; }

  /* ── CTA STRIP ── */
  .bp-cta-strip { background: var(--amber); padding: 4.5rem 0; }
  .bp-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .bp-cta-h2 { font-family: var(--font-sans); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -0.04em; color: var(--ink); margin: 0 0 0.5rem; }
  .bp-cta-strip p { font-family: var(--font-sans); font-size: 1rem; color: rgba(17,24,39,0.65); margin: 0; }
  .bp-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .bp-cta-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: rgba(17,24,39,0.5); text-decoration: none; white-space: nowrap; }
  .bp-cta-phone:hover { color: var(--ink); }

  @media (max-width: 960px) {
    .bp-split { grid-template-columns: 1fr; gap: 3rem; }
    .bp-gallery-grid { grid-template-columns: 1fr 1fr; }
    .bp-gallery-large { grid-column: span 2; }
    .bp-spec-grid { grid-template-columns: repeat(2, 1fr); }
    .bp-cta-inner { flex-direction: column; text-align: center; }
    .bp-cta-btns { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .bp-spec-grid { grid-template-columns: 1fr; }
    .bp-creds { grid-template-columns: 1fr; }
    .bp-gallery-grid { grid-template-columns: 1fr; }
    .bp-gallery-large { grid-column: span 1; }
    .container { padding: 0 1.25rem; }
  }
</style>
