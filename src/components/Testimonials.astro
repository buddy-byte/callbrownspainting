---
const testimonials = [
  {
    id: 1,
    name: "Lessa Crow Homan",
    location: "Brewton, AL",
    service: "Complete House Transformation",
    rating: 5,
    text: "Thank you so much to Browns Painting (Boomer Brown) for making my dream house come to life!!! I would recommend these guys to anyone!!! They done a great job!!!",
    date: "July 2021",
    verified: true,
    featured: true
  },
  {
    id: 2,
    name: "Sarah Johnson",
    location: "Brewton, AL",
    service: "Interior Painting",
    rating: 5,
    text: "Barry did an amazing job painting our entire house. His attention to detail and professionalism was outstanding. The quality of work exceeded our expectations.",
    date: "November 2024",
    verified: true
  },
  {
    id: 3,
    name: "Mike Thompson",
    location: "Fairhope, AL",
    service: "Exterior Painting",
    rating: 5,
    text: "We needed our commercial building painted and Barry delivered exceptional results. He worked around our business hours and completed the project on time.",
    date: "October 2024",
    verified: true
  }
];

const featured = testimonials.find(t => t.featured) || testimonials[0];
const rest = testimonials.filter(t => t.id !== featured.id);
---

<!--
  STRUCTURE: Dark full-bleed section.
  Top: huge centered italic pull-quote — no sidebar, no split.
  Bottom: 3-col card row across full width.
  This is the ONLY section that uses centered content.
-->
<section class="testimonials">

  <!-- Pull-quote hero — centered, nothing beside it -->
  <div class="testi-quote-zone">
    <div class="testi-quote-mark">"</div>
    <blockquote class="testi-pull">
      {featured.text}
    </blockquote>
    <div class="testi-pull-attr">
      <span class="testi-pull-stars">★★★★★</span>
      <strong>{featured.name}</strong> · {featured.location} · <em>{featured.service}</em>
    </div>
  </div>

  <!-- Divider -->
  <div class="testi-divider">
    <span class="eyebrow">More From Our Customers</span>
  </div>

  <!-- Full-width 3-col card row -->
  <div class="testi-cards">
    {rest.map(t => (
      <div class="testi-card">
        <div class="testi-card-top">
          <div>
            <strong class="testi-card-name">{t.name}</strong>
            <span class="testi-card-loc">{t.location}</span>
            <span class="testi-card-svc">{t.service}</span>
          </div>
          <span class="testi-card-stars">★★★★★</span>
        </div>
        <p class="testi-card-text">"{t.text}"</p>
        <div class="testi-card-foot">
          <span>{t.date}</span>
          {t.verified && <span class="testi-verified">✓ Verified</span>}
        </div>
      </div>
    ))}

    <!-- Google CTA card -->
    <div class="testi-google-card">
      <div class="testi-google-logo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
      </div>
      <div>
        <div class="testi-google-stars">★★★★★</div>
        <p class="testi-google-text">Rated 5 stars on Google across South Alabama.</p>
        <a href="https://www.google.com/search?q=browns+painting+brewton+al+reviews" target="_blank" rel="noopener noreferrer" class="testi-google-link">See Google Reviews →</a>
      </div>
    </div>
  </div>

</section>

<style>
  /* ── STRUCTURE: Dark full-bleed. Centered pull-quote top, 3-col cards bottom. ── */
  .testimonials {
    background: var(--ink-soft);
    padding: 0;
  }

  /* Pull-quote hero zone — full-width, centered, cinematic */
  .testi-quote-zone {
    max-width: 860px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    text-align: center;
    position: relative;
  }

  .testi-quote-mark {
    font-family: var(--font-display);
    font-size: 10rem;
    line-height: 0.6;
    color: rgba(245,158,11,0.15);
    margin-bottom: 1.5rem;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .testi-pull {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: rgba(255,255,255,0.92);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .testi-pull-attr {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.02em;
  }

  .testi-pull-stars {
    color: var(--amber);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .testi-pull-attr strong {
    color: rgba(255,255,255,0.75);
    font-weight: 700;
  }

  .testi-pull-attr em {
    color: var(--amber);
    font-style: normal;
  }

  /* Divider bar — eyebrow label, full-width horizontal rule */
  .testi-divider {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .testi-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.07);
  }

  .testi-divider .eyebrow {
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
  }

  /* Card row — full-width 3-col (or 4 with Google) */
  .testi-cards {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .testi-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .testi-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .testi-card-name {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
    margin-bottom: 0.125rem;
  }

  .testi-card-loc {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    margin-bottom: 0.2rem;
  }

  .testi-card-svc {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--amber);
  }

  .testi-card-stars {
    color: var(--amber);
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .testi-card-text {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1rem;
  }

  .testi-card-foot {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.25);
    padding-top: 0.875rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .testi-verified { color: #34d399; font-weight: 600; }

  /* Google card */
  .testi-google-card {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .testi-google-logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .testi-google-stars { color: var(--amber); font-size: 0.875rem; margin-bottom: 0.375rem; }

  .testi-google-text {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.5;
    margin-bottom: 0.625rem;
  }

  .testi-google-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 800;
    color: #60a5fa;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .testi-cards { grid-template-columns: 1fr; }
    .testi-pull { font-size: 1.375rem; }
    .testi-quote-mark { font-size: 7rem; }
  }
</style>
