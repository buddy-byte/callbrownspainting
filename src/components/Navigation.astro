              <a href="/silverhill-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Silverhill</a>
              <a href="/robertsdale-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Robertsdale</a>
              <a href="/summerdale-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Summerdale</a>
            </div>
            <div style="margin-bottom: 0;">
              <h4 style="color: #1f2937; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #3b82f6; padding-bottom: 0.4rem;">Mobile County</h4>
