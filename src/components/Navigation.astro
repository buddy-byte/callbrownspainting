              <a href="/saraland-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Saraland</a>
              <a href="/theodore-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Theodore</a>
              <a href="/creola-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Creola</a>
              <h4 style="color: #1f2937; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.75rem; margin-top: 1rem; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #3b82f6; padding-bottom: 0.4rem;">Conecuh County</h4>
