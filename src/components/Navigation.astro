              <a href="/castleberry-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Castleberry</a>
              <a href="/lenox-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Lenox</a>
