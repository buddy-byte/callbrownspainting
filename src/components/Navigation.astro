        <span class="contact-item">
          <span class="icon">📞</span>
          <a href="tel:+12512374545">(251) 237-4545</a>
        </span>
        <span class="contact-item">
          <span class="icon">✉️</span>
          <a href="mailto:hello@callbrownspainting.com">hello@callbrownspainting.com</a>
        </span>
        <span class="contact-item">
          <span class="icon">🕒</span>
          <span>Mon-Fri: 7AM-6PM</span>
