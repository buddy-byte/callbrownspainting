              <a href="/fairhope-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Fairhope</a>
              <a href="/daphne-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Daphne</a>
              <a href="/gulf-shores-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Gulf Shores</a>
              <a href="/orange-beach-painting" style="display: block; color: #6b7280; text-decoration: none; padding: 0.5rem; font-size: 0.8125rem; font-weight: 500; border-radius: 6px;">Orange Beach</a>
