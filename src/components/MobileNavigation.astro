<!-- ── MAIN NAV — dark transparent, logo overflows ── -->
<nav class="main-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Browns Painting Home">
      <img src="/images/logo/browns-logo-brush-b.png" alt="Browns Painting LLC" class="nav-logo-img" />
    </a>

    <div class="nav-links" id="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/about" class="nav-link">About</a>

      <div class="nav-dropdown">
        <button class="nav-drop-btn" aria-expanded="false">
          Services
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="nav-chevron"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-drop-panel">
          <a href="/interior-painting">Interior Painting</a>
          <a href="/exterior-painting">Exterior Painting</a>
          <a href="/commercial-painting">Commercial Painting</a>
          <a href="/services">All Services</a>
        </div>
      </div>

      <div class="nav-dropdown">
        <button class="nav-drop-btn" aria-expanded="false">
          Locations
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="nav-chevron"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-drop-panel nav-drop-wide">
          <div class="nav-drop-cols">
            <div>
              <span class="nav-drop-head">Escambia</span>
              <a href="/brewton-painting">Brewton</a>
              <a href="/atmore-painting">Atmore</a>
            </div>
            <div>
              <span class="nav-drop-head">Baldwin</span>
              <a href="/fairhope-painting">Fairhope</a>
              <a href="/daphne-painting">Daphne</a>
              <a href="/gulf-shores-painting">Gulf Shores</a>
              <a href="/foley-painting">Foley</a>
            </div>
            <div>
              <span class="nav-drop-head">Mobile</span>
              <a href="/mobile-painting">Mobile</a>
              <a href="/saraland-painting">Saraland</a>
              <span class="nav-drop-head" style="margin-top:.75rem">Monroe</span>
              <a href="/monroeville-painting">Monroeville</a>
            </div>
          </div>
        </div>
      </div>

      <a href="/blog" class="nav-link">Blog</a>
      <a href="/gallery" class="nav-link">Gallery</a>
    </div>

    <div class="nav-right">
      <a href="/contact" class="nav-quote-btn">Free Estimate →</a>
    </div>

    <button class="mobile-toggle" id="mobile-toggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
    const links = document.getElementById('nav-links') as HTMLElement;

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.classList.toggle('is-open');
      links?.classList.toggle('is-open');
    });

    document.querySelectorAll('.nav-drop-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        const open = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.nav-drop-btn').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          (b.nextElementSibling as HTMLElement)?.classList.remove('is-open');
        });
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          (btn.nextElementSibling as HTMLElement)?.classList.add('is-open');
        }
      });
    });

    document.addEventListener('click', e => {
      if (!(e.target as Element).closest('.main-nav')) {
        document.querySelectorAll('.nav-drop-panel').forEach(p => p.classList.remove('is-open'));
        document.querySelectorAll('.nav-drop-btn').forEach(b => b.setAttribute('aria-expanded','false'));
      }
    });
  });

  window.addEventListener('scroll', () => {
    document.querySelector('.main-nav')?.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });
</script>

<style>
  /* ═══════════════════════════════════
     UTILITY BAR
  ═══════════════════════════════════ */
  .util-bar {
    background: #0a0e16;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1001;
  }

  .util-inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 42px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .util-phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--amber);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .util-phone:hover { color: var(--amber-light); }

  .util-sep {
    width: 1px;
    height: 18px;
    background: rgba(255,255,255,0.12);
    margin: 0 1.25rem;
    flex-shrink: 0;
  }

  .util-tagline {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    white-space: nowrap;
    flex: 1;
    text-align: center;
    letter-spacing: 0.02em;
  }

  .util-link {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .util-link:hover { color: rgba(255,255,255,0.95); }

  /* ═══════════════════════════════════
     MAIN NAV — dark transparent
  ═══════════════════════════════════ */
  .main-nav {
    background: rgba(10, 14, 22, 0.48);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    position: fixed;
    top: 42px;
    left: 0;
    right: 0;
    z-index: 1000;
    overflow: visible;
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .main-nav.scrolled {
    background: rgba(10, 14, 22, 0.96);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 4px 32px rgba(0,0,0,0.35);
  }

  .nav-inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 74px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    overflow: visible;
  }

  /* ═══════════════════════════════════
     LOGO — orange B mark + wordmark
     The B mark overflows the nav height
     to create a sharp branded anchor
  ═══════════════════════════════════ */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    overflow: visible;
  }

  /* Logo image — dark version blends with dark transparent nav */
  .nav-logo-img {
    height: 68px;
    width: auto;
    object-fit: contain;
  }


  /* ═══════════════════════════════════
     NAV LINKS — white on dark nav
  ═══════════════════════════════════ */
  .nav-links {
    display: none;
    align-items: center;
    gap: 0;
    margin: 0 auto;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255,255,255,0.82);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
  .nav-link:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* Dropdown */
  .nav-dropdown { position: relative; }

  .nav-drop-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255,255,255,0.82);
    background: none;
    border: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-drop-btn:hover { color: #fff; background: rgba(255,255,255,0.1); }
  .nav-drop-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .nav-chevron { opacity: 0.5; transition: transform 0.2s ease; }
  .nav-drop-btn[aria-expanded="true"] .nav-chevron { transform: rotate(180deg); opacity: 1; }

  .nav-drop-panel {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 200px;
    background: #0d1219;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4), 0 4px 16px rgba(0,0,0,0.2);
    padding: 0.5rem;
    z-index: 100;
  }

  .nav-drop-panel.is-open { display: block; }
  .nav-dropdown:hover .nav-drop-panel { display: block; }

  .nav-drop-panel a {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
  }

  .nav-drop-panel a:hover { background: rgba(255,255,255,0.07); color: #fff; }

  .nav-drop-wide { min-width: 520px; }

  .nav-drop-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 0.75rem;
  }

  .nav-drop-cols > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .nav-drop-head {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
    padding: 0.375rem 0.875rem 0.25rem;
    display: block;
  }

  /* ── CTA button ── */
  .nav-right {
    display: none;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-quote-btn {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 800;
    color: #fff;
    background: var(--amber);
    text-decoration: none;
    padding: 0.65rem 1.375rem;
    border-radius: 8px;
    white-space: nowrap;
    letter-spacing: 0.01em;
    box-shadow: 0 2px 16px rgba(249,115,22,0.45);
  }

  .nav-quote-btn:hover {
    background: var(--amber-deep);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249,115,22,0.55);
  }

  /* ── Hamburger ── */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    margin-left: auto;
    width: 42px;
    height: 42px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    cursor: pointer;
    padding: 0 10px;
    flex-shrink: 0;
  }

  .mobile-toggle span {
    display: block;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .mobile-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-toggle.is-open span:nth-child(2) { opacity: 0; }
  .mobile-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── DESKTOP ── */
  @media (min-width: 900px) {
    .mobile-toggle { display: none; }
    .nav-links { display: flex; }
    .nav-right { display: flex; }
  }

  /* ── MOBILE ── */
  @media (max-width: 899px) {
    .util-tagline { display: none; }
    .util-sep { display: none; }
    .util-link { display: none; }

    .nav-links {
      position: fixed;
      top: 116px; /* 42px util + 74px nav */
      left: 0;
      right: 0;
      background: #0d1219;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 1rem;
      max-height: 80vh;
      overflow-y: auto;
      z-index: 998;
    }

    .nav-links.is-open { display: flex; }

    .nav-link, .nav-drop-btn {
      width: 100%;
      padding: 0.875rem 1.5rem;
      border-radius: 0;
      font-size: 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.85);
    }

    .nav-drop-panel {
      position: static;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: rgba(255,255,255,0.04);
      padding: 0.25rem 0;
    }

    .nav-drop-wide { min-width: unset; }
    .nav-drop-cols { grid-template-columns: 1fr; padding: 0.5rem 1.5rem; }
    .nav-drop-cols > div a { padding-left: 0.875rem; }
  }
</style>
