<!-- ── MAIN NAV ── -->
<nav class="main-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">

    <a href="/" class="nav-logo" aria-label="Browns Painting Home">
      <img src="/images/logo/browns-painting-logo-hat.png" alt="Browns Painting LLC" class="nav-logo-img" />
      <div class="nav-logo-text">
        <span class="nav-brand">Browns Painting</span>
        <span class="nav-tagline">South Alabama's Painters</span>
      </div>
    </a>

    <div class="nav-links" id="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/about" class="nav-link">About</a>

      <div class="nav-dropdown">
        <button class="nav-drop-btn" aria-expanded="false">
          Services
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="nav-chevron"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-drop-panel">
          <a href="/interior-painting">Interior Painting</a>
          <a href="/exterior-painting">Exterior Painting</a>
          <a href="/commercial-painting">Commercial Painting</a>
          <a href="/services">All Services</a>
        </div>
      </div>

      <div class="nav-dropdown">
        <button class="nav-drop-btn" aria-expanded="false">
          Locations
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="nav-chevron"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-drop-panel nav-drop-wide">
          <div class="nav-drop-cols">
            <div>
              <span class="nav-drop-head">Escambia</span>
              <a href="/brewton-painting">Brewton</a>
              <a href="/atmore-painting">Atmore</a>
            </div>
            <div>
              <span class="nav-drop-head">Baldwin</span>
              <a href="/fairhope-painting">Fairhope</a>
              <a href="/daphne-painting">Daphne</a>
              <a href="/gulf-shores-painting">Gulf Shores</a>
              <a href="/foley-painting">Foley</a>
            </div>
            <div>
              <span class="nav-drop-head">Mobile</span>
              <a href="/mobile-painting">Mobile</a>
              <a href="/saraland-painting">Saraland</a>
              <span class="nav-drop-head" style="margin-top:.75rem">Monroe</span>
              <a href="/monroeville-painting">Monroeville</a>
            </div>
          </div>
        </div>
      </div>

      <a href="/blog" class="nav-link">Blog</a>
      <a href="/gallery" class="nav-link">Gallery</a>
    </div>

    <div class="nav-right">
      <a href="tel:+12512374545" class="nav-phone-btn">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none"><path d="M11.9 9.2c-.2-.2-1.9-1.3-2.2-1.3-.2 0-.4.1-.9.7-.2.2-.3.3-.4.3-.2 0-.4-.1-.7-.3-.8-.5-1.6-1.3-2.1-2.1-.3-.4-.4-.6-.4-.7 0-.1.1-.2.3-.4.5-.5.7-.7.7-.9 0-.2-1.1-2-1.3-2.2-.2-.2-.3-.2-.5-.2-.4 0-.9.2-1.2.6-.4.4-.6 1-.6 1.6 0 1 .5 2.2 1.3 3.2.7.9 1.9 2 2.9 2.6.8.5 1.9 1 2.8 1 .5 0 1.1-.2 1.5-.6.3-.3.6-.8.6-1.2 0-.2-.1-.4-.5-.8z" fill="currentColor"/></svg>
        Call Now
      </a>
      <a href="/contact" class="nav-quote-btn">Get a Quote</a>
    </div>

    <button class="mobile-toggle" id="mobile-toggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
    const links = document.getElementById('nav-links') as HTMLElement;

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.classList.toggle('is-open');
      links?.classList.toggle('is-open');
    });

    document.querySelectorAll('.nav-drop-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        const open = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.nav-drop-btn').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          (b.nextElementSibling as HTMLElement)?.classList.remove('is-open');
        });
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          (btn.nextElementSibling as HTMLElement)?.classList.add('is-open');
        }
      });
    });

    document.addEventListener('click', e => {
      if (!(e.target as Element).closest('.main-nav')) {
        document.querySelectorAll('.nav-drop-panel').forEach(p => p.classList.remove('is-open'));
        document.querySelectorAll('.nav-drop-btn').forEach(b => b.setAttribute('aria-expanded','false'));
      }
    });
  });
</script>

<style>
  /* ── UTILITY BAR ── */
  .util-bar {
    background: var(--ink);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .util-inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .util-phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--amber);
    text-decoration: none;
    white-space: nowrap;
  }

  .util-phone:hover { color: var(--amber-light); }

  .util-sep {
    width: 1px;
    height: 16px;
    background: rgba(255,255,255,0.12);
    margin: 0 1rem;
    flex-shrink: 0;
  }

  .util-tagline {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    white-space: nowrap;
    flex: 1;
    text-align: center;
    letter-spacing: 0.02em;
  }

  .util-link {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .util-link:hover { color: rgba(255,255,255,0.9); }

  .util-cta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--amber);
    text-decoration: none;
    padding: 0.2rem 0.875rem;
    border-radius: 100px;
    margin-left: 0.875rem;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .util-cta:hover { background: var(--amber-light); }

  /* ── MAIN NAV ── */
  .main-nav {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 4px 16px rgba(0,0,0,0.04);
  }

  .nav-inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 72px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .nav-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .nav-brand {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 900;
    color: var(--ink);
    letter-spacing: -0.03em;
  }

  .nav-tagline {
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--amber-deep);
  }

  /* Links */
  .nav-links {
    display: none;
    align-items: center;
    gap: 0;
    margin: 0 auto;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .nav-link:hover { color: var(--ink); background: var(--cream); }
  .nav-link:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* Dropdown */
  .nav-dropdown { position: relative; }

  .nav-drop-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
    background: none;
    border: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .nav-drop-btn:hover { color: var(--ink); background: var(--cream); }
  .nav-drop-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .nav-chevron { opacity: 0.4; transition: transform 0.2s ease; }
  .nav-drop-btn[aria-expanded="true"] .nav-chevron { transform: rotate(180deg); opacity: 0.9; }

  .nav-drop-panel {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 200px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.10), 0 4px 12px rgba(0,0,0,0.06);
    padding: 0.5rem;
    z-index: 100;
  }

  .nav-drop-panel.is-open { display: block; }

  .nav-dropdown:hover .nav-drop-panel { display: block; }

  .nav-drop-panel a {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
  }

  .nav-drop-panel a:hover { background: var(--cream); color: var(--ink); }

  .nav-drop-wide { min-width: 520px; }

  .nav-drop-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 0.75rem;
  }

  .nav-drop-cols > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .nav-drop-head {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    padding: 0.375rem 0.875rem 0.25rem;
    display: block;
  }

  /* Right side */
  .nav-right {
    display: none;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .nav-phone-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    white-space: nowrap;
  }

  .nav-phone-btn:hover { border-color: var(--ink); background: var(--cream); }
  .nav-phone-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .nav-quote-btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--amber);
    text-decoration: none;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    white-space: nowrap;
    letter-spacing: -0.01em;
    box-shadow: 0 2px 12px rgba(245,158,11,0.35);
  }

  .nav-quote-btn:hover {
    background: var(--amber-deep);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(245,158,11,0.45);
  }

  .nav-quote-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* Hamburger */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    margin-left: auto;
    width: 42px;
    height: 42px;
    background: var(--ink);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    padding: 0 10px;
    flex-shrink: 0;
  }

  .mobile-toggle span {
    display: block;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .mobile-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-toggle.is-open span:nth-child(2) { opacity: 0; }
  .mobile-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-toggle:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* ── DESKTOP ── */
  @media (min-width: 900px) {
    .mobile-toggle { display: none; }
    .nav-links { display: flex; }
    .nav-right { display: flex; }
  }

  /* ── MOBILE ── */
  @media (max-width: 899px) {
    .util-tagline { display: none; }
    .util-sep { display: none; }
    .util-link { display: none; }

    .nav-links {
      position: absolute;
      top: 112px; /* util-bar 40 + nav 72 */
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 1rem;
      max-height: 80vh;
      overflow-y: auto;
      z-index: 998;
    }

    .nav-links.is-open { display: flex; }

    .nav-link, .nav-drop-btn {
      width: 100%;
      padding: 0.875rem 1.5rem;
      border-radius: 0;
      font-size: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .nav-drop-panel {
      position: static;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: var(--cream);
      padding: 0.25rem 0;
    }

    .nav-drop-wide { min-width: unset; }
    .nav-drop-cols { grid-template-columns: 1fr; padding: 0.5rem 1.5rem; }
    .nav-drop-cols > div a { padding-left: 0.875rem; }
  }
</style>
