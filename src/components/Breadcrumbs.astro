---
export interface Props {
  items: Array<{
    name?: string;
    label?: string;
    url: string;
    current?: boolean;
  }>;
}

const { items } = Astro.props;

// Normalize: accept both `name` and `label`, skip any item that is already 'Home'
const normalized = items
  .map(item => ({ ...item, name: item.name || item.label || '' }))
  .filter(item => item.url !== '/');

const breadcrumbItems = [
  { name: 'Home', url: '/', current: false },
  ...normalized,
];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumb-list">
    {breadcrumbItems.map((item, index) => (
      <li class="breadcrumb-item">
        {index > 0 && (
          <span class="breadcrumb-separator" aria-hidden="true">›</span>
        )}
        {item.current ? (
          <span class="breadcrumb-current" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="breadcrumb-link">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    background: var(--cream, #faf9f7);
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border, #e5e7eb);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    margin: 0 auto;
    padding: 0 2rem;
    max-width: 1200px;
    gap: 0;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    font-family: var(--font-sans, system-ui);
    font-size: 0.8125rem;
  }

  .breadcrumb-separator {
    color: var(--text-faint, #9ca3af);
    margin: 0 0.5rem;
  }

  .breadcrumb-link {
    color: var(--text-muted, #6b7280);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .breadcrumb-link:hover { color: var(--amber, #f59e0b); }

  .breadcrumb-current {
    color: var(--ink, #111827);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .breadcrumb-list { padding: 0 1.25rem; }
    .breadcrumb-item { font-size: 0.75rem; }
  }
</style>




