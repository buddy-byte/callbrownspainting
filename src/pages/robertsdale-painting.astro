---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Robertsdale Painting', url: '/robertsdale-painting' }
];
---

<BaseLayout
  title="Painting Services in Robertsdale, AL | Browns Painting LLC"
  description="Professional painting services in Robertsdale, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Robertsdale AL, house painter Robertsdale Alabama, Baldwin County painting services, interior painting Robertsdale, exterior painting Robertsdale"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Robertsdale AL"
    serviceDescription="Expert painting services in Robertsdale, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/robertsdale-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Robertsdale"
      county="Baldwin County"
      slug="robertsdale"
      nearbyLinks={[
  { name: 'Loxley', url: '/loxley-painting' },
  { name: 'Bay Minette', url: '/bay-minette-painting' },
  { name: 'Foley', url: '/foley-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
