---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
---

<BaseLayout
  title="Contact Browns Painting — Free Estimate"
  description="Contact Barry 'Boomer' Brown for professional painting services in South Alabama. Free estimates. (251) 236-1411"
  keywords="contact painting contractor Brewton AL, painting estimate South Alabama, Barry Boomer Brown painter"
>
  <main>
    <InnerPageHero
      title="Get Your Free Estimate"
      subtitle="Call, text, or fill out the form — we respond within 24 hours."
      eyebrow="Contact Us"
      bg="/images/boomer-photos/boomer-2-optimized.jpg"
      ctaText="Call Now"
      ctaHref="tel:+12512361411"
    />

    <!-- ── CONTACT SECTION ── -->
    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">

          <!-- Form column -->
          <div class="form-col">
            <div class="form-header">
              <span class="eyebrow">Free Estimate</span>
              <h2 class="form-h2">Request a Quote</h2>
              <p>Fill out the form and Boomer will get back to you within 24 hours.</p>
            </div>

            <form class="contact-form" method="POST" action="/api/contact">
              <div class="field-row">
                <div class="field">
                  <label for="name">Full Name *</label>
                  <input type="text" id="name" name="name" required placeholder="John Smith" />
                </div>
                <div class="field">
                  <label for="phone">Phone Number *</label>
                  <input type="tel" id="phone" name="phone" required placeholder="(251) 555-0000" />
                </div>
              </div>
              <div class="field">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com" />
              </div>
              <div class="field">
                <label for="subject">Type of Work *</label>
                <select id="subject" name="subject" required>
                  <option value="">Select a service…</option>
                  <option>Interior Painting</option>
                  <option>Exterior Painting</option>
                  <option>Commercial Painting</option>
                  <option>Cabinet Refinishing</option>
                  <option>Pressure Washing</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="field">
                <label for="message">Describe Your Project *</label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell us about your project — size, current condition, timeline, any specific requirements…"></textarea>
              </div>
              <button type="submit" class="submit-btn">Send Request →</button>
            </form>
          </div>

          <!-- Info column -->
          <div class="info-col">

            <div class="info-card">
              <div class="info-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.27 11.36 11.36 0 003.55.56 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.56 3.55 1 1 0 01-.27 1.11z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <h4>Phone &amp; Text</h4>
                <a href="tel:+12512361411" class="info-link-big">(251) 236-1411</a>
                <p>Fastest way to reach Boomer</p>
              </div>
            </div>

            <div class="info-card">
              <div class="info-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.75"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.75"/></svg>
              </div>
              <div>
                <h4>Email</h4>
                <a href="mailto:boomer@callbrownspainting.com" class="info-link">boomer@callbrownspainting.com</a>
                <p>We reply within 24 hours</p>
              </div>
            </div>

            <div class="info-card">
              <div class="info-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.75"/><path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </div>
              <div>
                <h4>Business Hours</h4>
                <p><strong>Mon–Fri:</strong> 7:00 AM – 4:00 PM</p>
                <p><strong>Sat–Sun:</strong> By Appointment</p>
                <p class="info-emerg">Emergency services available 7 days</p>
              </div>
            </div>

            <div class="info-card info-card-dark">
              <div class="info-card-icon info-icon-dark">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <h4>Service Area</h4>
                <p>Serving Escambia, Conecuh, Monroe, Mobile, and Baldwin Counties — 20+ cities across South Alabama.</p>
                <a href="/service-areas" class="info-areas-link">View All Service Areas →</a>
              </div>
            </div>

            <!-- Trust tiles -->
            <div class="trust-tiles">
              <div class="trust-tile">
                <strong>25+</strong>
                <span>Years</span>
              </div>
              <div class="trust-tile">
                <strong>500+</strong>
                <span>Projects</span>
              </div>
              <div class="trust-tile">
                <strong>5★</strong>
                <span>Google</span>
              </div>
              <div class="trust-tile">
                <strong>AL</strong>
                <span>Licensed</span>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  .eyebrow {
    display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber);
  }

  .contact-section { background: var(--cream); padding: 5.5rem 0 6rem; }

  .contact-grid { display: grid; grid-template-columns: 1fr 420px; gap: 5rem; align-items: start; }

  /* ── FORM ── */
  .form-col { display: flex; flex-direction: column; gap: 2.5rem; }

  .form-header { display: flex; flex-direction: column; gap: 0.625rem; }

  .form-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }

  .form-header p { font-family: var(--font-sans); font-size: 1.0625rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

  .field { display: flex; flex-direction: column; gap: 0.4rem; }

  .field label { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 800; color: var(--ink); letter-spacing: 0.01em; }

  .field input, .field select, .field textarea {
    font-family: var(--font-sans); font-size: 0.9375rem; color: var(--ink);
    background: var(--white); border: 1.5px solid var(--border);
    border-radius: var(--radius-md); padding: 0.875rem 1rem;
    transition: border-color 0.2s, box-shadow 0.2s; outline: none; width: 100%; box-sizing: border-box;
  }

  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: var(--amber); box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
  }

  .field textarea { resize: vertical; min-height: 130px; }

  .submit-btn {
    padding: 1rem 2.25rem; background: var(--amber); color: var(--ink);
    font-family: var(--font-sans); font-size: 1rem; font-weight: 800;
    border: none; border-radius: var(--radius-md); cursor: pointer;
    box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s;
    align-self: flex-start;
  }
  .submit-btn:hover { background: var(--amber-deep); transform: translateY(-2px); }

  /* ── INFO ── */
  .info-col { display: flex; flex-direction: column; gap: 1rem; padding-top: 6.5rem; }

  .info-card {
    background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 1.5rem 1.5rem; display: flex; gap: 1rem; align-items: flex-start;
  }

  .info-card-dark { background: var(--ink-soft); border-color: rgba(255,255,255,0.06); }
  .info-card-dark h4 { color: #fff !important; }
  .info-card-dark p { color: rgba(255,255,255,0.45) !important; }

  .info-card-icon {
    width: 44px; height: 44px; flex-shrink: 0;
    background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);
    border-radius: 12px; display: flex; align-items: center; justify-content: center;
    color: var(--amber);
  }

  .info-icon-dark { background: rgba(245,158,11,0.08); }

  .info-card h4 { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 800; color: var(--ink); margin: 0 0 0.375rem; letter-spacing: -0.01em; }
  .info-card p { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin: 0.2rem 0 0; }

  .info-link-big { font-family: var(--font-sans); font-size: 1.375rem; font-weight: 900; letter-spacing: -0.03em; color: var(--ink); text-decoration: none; display: block; }
  .info-link-big:hover { color: var(--amber-deep); }

  .info-link { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 700; color: var(--amber-deep); text-decoration: none; display: block; }
  .info-link:hover { text-decoration: underline; }

  .info-emerg { color: var(--amber-deep) !important; font-weight: 700 !important; }

  .info-areas-link { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 800; color: var(--amber); text-decoration: none; margin-top: 0.5rem; display: inline-block; }
  .info-areas-link:hover { text-decoration: underline; }

  .trust-tiles {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1.5px; background: var(--border); border: 1.5px solid var(--border);
    border-radius: var(--radius-lg); overflow: hidden;
  }

  .trust-tile { background: var(--white); padding: 1.25rem 0.5rem; text-align: center; display: flex; flex-direction: column; gap: 0.25rem; }
  .trust-tile strong { font-family: var(--font-sans); font-size: 1.375rem; font-weight: 900; letter-spacing: -0.04em; color: var(--amber); line-height: 1; }
  .trust-tile span { font-family: var(--font-sans); font-size: 0.5625rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); }

  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: 1fr; gap: 4rem; }
    .info-col { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .field-row { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
