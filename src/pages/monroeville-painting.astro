---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Monroeville Painting', url: '/monroeville-painting' }
];
---

<BaseLayout
  title="Painting Services in Monroeville, AL | Browns Painting LLC"
  description="Professional painting services in Monroeville, Alabama. Interior, exterior, and commercial painting by Browns Painting — Monroe County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Monroeville AL, house painter Monroeville Alabama, Monroe County painting services, interior painting Monroeville, exterior painting Monroeville"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Monroeville AL"
    serviceDescription="Expert painting services in Monroeville, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/monroeville-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Monroeville"
      county="Monroe County"
      slug="monroeville"
      nearbyLinks={[
  { name: 'Evergreen', url: '/evergreen-painting' },
  { name: 'Brewton', url: '/brewton-painting' },
  { name: 'Mobile', url: '/mobile-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
