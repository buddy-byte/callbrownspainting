---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Mobile Painting', url: '/mobile-painting' }
];
---

<BaseLayout
  title="Painting Services in Mobile, AL | Browns Painting LLC"
  description="Professional painting services in Mobile, Alabama. Interior, exterior, and commercial painting by Browns Painting — Mobile County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Mobile AL, house painter Mobile Alabama, Mobile County painting services, interior painting Mobile, exterior painting Mobile"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Mobile AL"
    serviceDescription="Expert painting services in Mobile, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/mobile-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Mobile"
      county="Mobile County"
      slug="mobile"
      nearbyLinks={[
  { name: 'Saraland', url: '/saraland-painting' },
  { name: 'Theodore', url: '/theodore-painting' },
  { name: 'Daphne', url: '/daphne-painting' },
  { name: 'Fairhope', url: '/fairhope-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
