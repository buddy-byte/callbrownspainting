---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import Testimonials from '../components/Testimonials.astro';

const title = "Commercial Painting Services | Browns Painting South Alabama";
const description = "Professional commercial painting for offices, retail, churches, and schools across South Alabama. After-hours scheduling. Licensed and insured.";
---

<BaseLayout title={title} description={description}>
  <main>

    <InnerPageHero
      title="Commercial Painting Services"
      subtitle="After-hours scheduling, minimal disruption, commercial-grade results for any business or facility."
      eyebrow="Commercial Painting"
      bg="/images/hero/hero-1-optimized.jpg"
    />

    <!-- ── WHAT WE DO ── -->
    <section class="cp-section cp-cream">
      <div class="container">
        <div class="cp-header">
          <span class="eyebrow">What We Do</span>
          <h2 class="cp-h2">Professional Results. <em>Minimal Disruption.</em></h2>
          <p class="cp-intro">We understand that your business can't stop for a paint job. We work nights and weekends, keep job sites clean and organized, and deliver commercial-grade results on schedule.</p>
        </div>

        <div class="cp-services-grid">
          <div class="cp-svc">
            <div class="cp-svc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18M2 22h20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 12h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></div>
            <h4>Office &amp; Retail Spaces</h4>
            <p>Interior and exterior painting for office buildings, retail stores, and mixed-use properties. We match your brand colors and work on your schedule.</p>
          </div>
          <div class="cp-svc">
            <div class="cp-svc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg></div>
            <h4>Churches &amp; Schools</h4>
            <p>Large-scale interior and exterior painting for institutional facilities. We work during breaks, holidays, and off-hours to minimize disruption.</p>
          </div>
          <div class="cp-svc">
            <div class="cp-svc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></div>
            <h4>Multi-Unit Properties</h4>
            <p>Apartment complexes, HOA communities, and multi-unit residential properties. Coordinated scheduling for minimal resident disruption.</p>
          </div>
          <div class="cp-svc">
            <div class="cp-svc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h4>Industrial &amp; Warehouse</h4>
            <p>Epoxy floors, warehouse interiors, and industrial exterior coatings. We bring commercial-grade equipment and materials.</p>
          </div>
          <div class="cp-svc">
            <div class="cp-svc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.75"/><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            <h4>Emergency &amp; Storm Damage</h4>
            <p>Fast response for commercial properties damaged by storms. We work with your insurance adjuster and get you back to business fast.</p>
          </div>
          <div class="cp-svc cp-svc-cta">
            <span class="eyebrow" style="color:var(--amber)">Get Started</span>
            <h4>Ready for a Commercial Quote?</h4>
            <p>We provide detailed written estimates with scope of work, materials, timeline, and pricing.</p>
            <a href="/contact" class="btn-amber" style="margin-top:0.5rem">Request a Quote →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── WHY BROWNS FOR COMMERCIAL ── -->
    <section class="cp-section cp-dark">
      <div class="container">
        <div class="cp-dark-split">
          <div>
            <span class="eyebrow">Why Browns</span>
            <h2 class="cp-h2 cp-h2-white">Commercial-Grade Standards. <em>Family-Owned Service.</em></h2>
            <p class="cp-dark-body">We bring the quality, equipment, and professionalism of a large contractor — with the personal accountability of a family-owned business. Boomer personally oversees every commercial job.</p>
            <ul class="cp-checklist">
              <li>After-hours &amp; weekend scheduling available</li>
              <li>Detailed written estimates with full scope</li>
              <li>Commercial-grade paints &amp; coatings</li>
              <li>Fully licensed &amp; insured for commercial work</li>
              <li>OSHA-compliant job sites</li>
              <li>Multiple crews for large-scale projects</li>
            </ul>
          </div>
          <div class="cp-dark-stats">
            <div class="cp-stat">
              <strong>25+</strong>
              <span>Years Commercial Experience</span>
            </div>
            <div class="cp-stat">
              <strong>100%</strong>
              <span>Satisfaction Guarantee</span>
            </div>
            <div class="cp-stat">
              <strong>5★</strong>
              <span>Rated on Google</span>
            </div>
            <div class="cp-stat">
              <strong>AL</strong>
              <span>Licensed &amp; Insured</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Testimonials />

    <section class="cp-cta-strip">
      <div class="container cp-cta-inner">
        <div>
          <h2 class="cp-cta-h2">Let's Talk About Your Commercial Project.</h2>
          <p>Free site visits, written estimates, and zero-pressure consultations.</p>
        </div>
        <div class="cp-cta-btns">
          <a href="/contact" class="btn-dark">Get a Commercial Quote →</a>
          <a href="tel:+12512374545" class="cp-phone">(251) 237-4545</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .eyebrow { display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }
  .btn-amber { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--amber); color: var(--ink); font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s; }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }
  .btn-dark { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--ink); color: #fff; font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); border: 1.5px solid rgba(255,255,255,0.15); transition: background 0.2s; white-space: nowrap; }
  .btn-dark:hover { background: #1a2535; }

  .cp-section { padding: 5.5rem 0 6rem; }
  .cp-cream { background: var(--cream); }
  .cp-dark { background: var(--ink-soft); }

  .cp-header { max-width: 700px; margin-bottom: 3.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .cp-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }
  .cp-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber-deep); letter-spacing: -0.02em; }
  .cp-h2-white { color: #fff; }
  .cp-h2-white em { color: var(--amber); }
  .cp-intro { font-family: var(--font-sans); font-size: 1.0625rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  .cp-services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }
  .cp-svc { background: var(--white); padding: 2rem 1.75rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .cp-svc-cta { background: var(--ink); }
  .cp-svc-cta h4 { color: #fff !important; }
  .cp-svc-cta p { color: rgba(255,255,255,0.45) !important; }
  .cp-svc-icon { width: 48px; height: 48px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--amber); flex-shrink: 0; }
  .cp-svc h4 { font-family: var(--font-sans); font-size: 1.0625rem; font-weight: 800; color: var(--ink); margin: 0; letter-spacing: -0.02em; }
  .cp-svc p { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0; }

  .cp-dark-split { display: grid; grid-template-columns: 1fr 380px; gap: 5rem; align-items: start; }
  .cp-dark-body { font-family: var(--font-sans); font-size: 1.0625rem; color: rgba(255,255,255,0.5); line-height: 1.7; margin: 0.75rem 0 1.5rem; }
  .cp-checklist { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .cp-checklist li { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 600; color: rgba(255,255,255,0.75); padding-left: 1.5rem; position: relative; }
  .cp-checklist li::before { content: '✓'; position: absolute; left: 0; color: var(--amber); font-weight: 800; }
  .cp-dark-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5px; background: rgba(255,255,255,0.06); border: 1.5px solid rgba(255,255,255,0.06); border-radius: var(--radius-xl); overflow: hidden; align-self: flex-start; margin-top: 4rem; }
  .cp-stat { background: var(--ink-soft); padding: 1.75rem 1.5rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .cp-stat strong { font-family: var(--font-sans); font-size: 2.25rem; font-weight: 900; letter-spacing: -0.04em; color: var(--amber); line-height: 1; }
  .cp-stat span { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.3); }

  .cp-cta-strip { background: var(--ink); padding: 4.5rem 0; }
  .cp-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .cp-cta-h2 { font-family: var(--font-sans); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.15; color: #fff; margin: 0 0 0.5rem; }
  .cp-cta-strip p { font-family: var(--font-sans); font-size: 1rem; color: rgba(255,255,255,0.4); margin: 0; }
  .cp-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .cp-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: rgba(255,255,255,0.35); text-decoration: none; white-space: nowrap; }
  .cp-phone:hover { color: var(--amber); }

  @media (max-width: 960px) {
    .cp-services-grid { grid-template-columns: repeat(2, 1fr); }
    .cp-dark-split { grid-template-columns: 1fr; gap: 3rem; }
    .cp-dark-stats { margin-top: 0; max-width: 400px; }
    .cp-cta-inner { flex-direction: column; text-align: center; }
    .cp-cta-btns { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .cp-services-grid { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
