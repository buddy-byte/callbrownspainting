---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';

const faqs = [
  {
    category: 'Pricing & Estimates',
    items: [
      { q: 'How much does house painting cost in South Alabama?', a: 'Painting costs typically range from $2.50–$4.50 per square foot for interior work and $1.80–$3.50 per square foot for exterior painting. The final price depends on home size, surface preparation needed, paint quality, and project complexity. We offer free, detailed on-site estimates for all South Alabama properties.' },
      { q: 'Are your estimates really free?', a: 'Yes — completely free, no obligation. Boomer comes to your property, evaluates the scope of work, and provides a written estimate with a clear breakdown of materials, labor, and timeline.' },
      { q: 'Do you provide written quotes?', a: 'Always. Every estimate is documented in writing so you know exactly what you are getting and at what price. No surprises, no hidden fees.' },
    ]
  },
  {
    category: 'Timeline & Scheduling',
    items: [
      { q: 'How long does it take to paint a house?', a: 'Most residential projects take 3–7 days. Interior painting for an average home typically takes 2–4 days; exterior painting usually requires 3–5 days depending on weather. We provide a detailed timeline during your estimate.' },
      { q: 'How soon can you start?', a: 'We typically schedule new projects within 1–2 weeks of signing. Emergency or damage-related work can often be prioritized.' },
      { q: 'Do I need to be home during the painting?', a: 'Not necessarily. Many homeowners prefer to be away during painting. We are fully insured and trustworthy, and we can work independently once access is arranged. For interior projects, many homeowners prefer to be present initially — entirely your choice.' },
    ]
  },
  {
    category: 'Paint & Materials',
    items: [
      { q: 'What brands of paint do you use?', a: 'We primarily use Sherwin-Williams and Benjamin Moore. These professional-grade paints offer superior coverage, durability, and color retention — essential for Alabama\'s humid climate. We can accommodate specific brand preferences if needed.' },
      { q: 'Do you use low-VOC or eco-friendly paints?', a: 'Yes. We offer low-VOC and zero-VOC paint options for homeowners concerned about indoor air quality. These are safer for families and pets while still providing excellent coverage and durability.' },
      { q: 'What type of paint is best for Alabama\'s climate?', a: 'For exteriors, we recommend 100% acrylic latex paints with mildew resistance and UV protection. For interiors, moisture-resistant paints in high-humidity areas like bathrooms and kitchens. Our 25+ years of experience in this climate means we select the right product for every surface.' },
      { q: 'Do you provide the paint or do I need to buy it?', a: 'We provide all materials — paint, primer, and supplies — as part of our service. This ensures we use the correct professional-grade products in the right quantities. If you have specific preferences or already purchased paint, we are happy to work with your materials.' },
    ]
  },
  {
    category: 'Process & Prep',
    items: [
      { q: 'What does your prep work include?', a: 'Proper preparation is the foundation of a lasting paint job. For interiors: we fill holes and cracks, sand surfaces, tape off trim, and protect flooring before painting. For exteriors: pressure washing, scraping loose paint, sanding, caulking all gaps and cracks, and spot-priming bare wood.' },
      { q: 'Do you move furniture?', a: 'Yes — we move furniture to the center of the room and cover it. After the job is done, we return everything to its original position and do a thorough cleanup.' },
      { q: 'How many coats of paint do you apply?', a: 'We apply primer where needed plus two full finish coats on all surfaces. Some surfaces or dramatic color changes may require additional preparation, which we will discuss during your estimate.' },
    ]
  },
  {
    category: 'Guarantee & Quality',
    items: [
      { q: 'What is your satisfaction guarantee?', a: 'Simple: we do not call it done until you are completely happy. If anything is not right after our walkthrough, we come back and fix it — no charge, no questions asked.' },
      { q: 'Are you licensed and insured?', a: 'Yes. Browns Painting is fully licensed and insured throughout South Alabama. We carry comprehensive liability insurance and workers\' compensation coverage, protecting both our team and your property. We are happy to provide proof of insurance on request.' },
      { q: 'Will the owner be on site?', a: 'Absolutely. Boomer personally oversees every project — residential or commercial. You are not getting handed off to a sub-crew. This is a core part of our commitment to quality.' },
    ]
  },
];
---

<BaseLayout
  title="Frequently Asked Questions | Browns Painting LLC"
  description="Answers to common questions about painting services, pricing, timelines, and process. South Alabama's trusted painting contractor since 1998."
>
  <main>
    <InnerPageHero
      title="Frequently Asked Questions"
      subtitle="Everything you need to know before hiring a painter — answered honestly."
      eyebrow="FAQ"
      bg="/images/hero/hero-3-optimized.jpg"
    />

    <section class="faq-page-section">
      <div class="container">

        {faqs.map((group) => (
          <div class="faq-group">
            <div class="faq-group-header">
              <span class="eyebrow">{group.category}</span>
            </div>
            <div class="faq-items">
              {group.items.map((item) => (
                <details class="faq-item">
                  <summary class="faq-q">{item.q}</summary>
                  <div class="faq-a"><p>{item.a}</p></div>
                </details>
              ))}
            </div>
          </div>
        ))}

      </div>
    </section>

    <!-- CTA -->
    <section class="faq-cta-strip">
      <div class="container faq-cta-inner">
        <div>
          <span class="eyebrow" style="color:var(--amber)">Still have questions?</span>
          <h2 class="faq-cta-h2">Just Call Boomer.</h2>
          <p>He picks up the phone. Free estimates, straight answers, no pressure.</p>
        </div>
        <div class="faq-cta-btns">
          <a href="tel:+12512374545" class="btn-amber">(251) 237-4545</a>
          <a href="/contact" class="faq-contact-link">Send a Message →</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 900px; margin: 0 auto; padding: 0 2rem; }

  .eyebrow { display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }

  .btn-amber { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--amber); color: var(--ink); font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s; }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  .faq-page-section { background: var(--cream); padding: 5.5rem 0 6rem; }

  .faq-group { margin-bottom: 3.5rem; }

  .faq-group-header { margin-bottom: 1.25rem; padding-bottom: 0.875rem; border-bottom: 1.5px solid var(--border); }

  .faq-items { display: flex; flex-direction: column; gap: 0; background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }

  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-item:last-child { border-bottom: none; }

  .faq-q {
    font-family: var(--font-sans); font-size: 1rem; font-weight: 800;
    color: var(--ink); padding: 1.5rem 1.75rem; cursor: pointer;
    list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    transition: background 0.15s;
    letter-spacing: -0.015em;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: '+'; font-size: 1.25rem; font-weight: 400; color: var(--amber); flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }
  .faq-item[open] .faq-q { background: rgba(245,158,11,0.04); }
  .faq-q:hover { background: var(--cream); }

  .faq-a { padding: 0 1.75rem 1.5rem; }
  .faq-a p { font-family: var(--font-sans); font-size: 0.9375rem; color: var(--text-muted); line-height: 1.75; margin: 0; }

  /* CTA */
  .faq-cta-strip { background: var(--ink-soft); padding: 5rem 0; }
  .faq-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; max-width: 1200px; }
  .faq-cta-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; letter-spacing: -0.04em; color: #fff; margin: 0.25rem 0 0.75rem; }
  .faq-cta-strip p { font-family: var(--font-sans); font-size: 1rem; color: rgba(255,255,255,0.45); line-height: 1.6; margin: 0; }
  .faq-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .faq-contact-link { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; color: rgba(255,255,255,0.35); text-decoration: none; white-space: nowrap; }
  .faq-contact-link:hover { color: var(--amber); }

  @media (max-width: 768px) {
    .faq-cta-inner { flex-direction: column; text-align: center; }
    .faq-cta-btns { flex-direction: column; }
    .container { padding: 0 1.25rem; }
  }
</style>
