---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Castleberry Painting', url: '/castleberry-painting' }
];
---

<BaseLayout
  title="Painting Services in Castleberry, AL | Browns Painting LLC"
  description="Professional painting services in Castleberry, Alabama. Interior, exterior, and commercial painting by Browns Painting — Conecuh County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Castleberry AL, house painter Castleberry Alabama, Conecuh County painting services, interior painting Castleberry, exterior painting Castleberry"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Castleberry AL"
    serviceDescription="Expert painting services in Castleberry, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/castleberry-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Castleberry"
      county="Conecuh County"
      slug="castleberry"
      nearbyLinks={[
  { name: 'Evergreen', url: '/evergreen-painting' },
  { name: 'Brewton', url: '/brewton-painting' },
  { name: 'Repton', url: '/repton-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
