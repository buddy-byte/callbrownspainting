---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Evergreen Painting', url: '/evergreen-painting' }
];
---

<BaseLayout
  title="Painting Services in Evergreen, AL | Browns Painting LLC"
  description="Professional painting services in Evergreen, Alabama. Interior, exterior, and commercial painting by Browns Painting — Conecuh County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Evergreen AL, house painter Evergreen Alabama, Conecuh County painting services, interior painting Evergreen, exterior painting Evergreen"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Evergreen AL"
    serviceDescription="Expert painting services in Evergreen, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/evergreen-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Evergreen"
      county="Conecuh County"
      slug="evergreen"
      nearbyLinks={[
  { name: 'Castleberry', url: '/castleberry-painting' },
  { name: 'Repton', url: '/repton-painting' },
  { name: 'Brewton', url: '/brewton-painting' },
  { name: 'Monroeville', url: '/monroeville-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
