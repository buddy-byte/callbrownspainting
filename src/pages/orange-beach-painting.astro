---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Orange Beach Painting', url: '/orange-beach-painting' }
];
---

<BaseLayout
  title="Painting Services in Orange Beach, AL | Browns Painting LLC"
  description="Professional painting services in Orange Beach, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Orange Beach AL, house painter Orange Beach Alabama, Baldwin County painting services, interior painting Orange Beach, exterior painting Orange Beach"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Orange Beach AL"
    serviceDescription="Expert painting services in Orange Beach, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/orange-beach-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Orange Beach"
      county="Baldwin County"
      slug="orange-beach"
      nearbyLinks={[
  { name: 'Gulf Shores', url: '/gulf-shores-painting' },
  { name: 'Foley', url: '/foley-painting' },
  { name: 'Fairhope', url: '/fairhope-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
