<script is:inline>
(function(){
  // ── Slideshow ──
  var slides = document.querySelectorAll('.slide');
  var dots = document.querySelectorAll('.dot');
  var cur = 0, t;
  if (!slides.length) return;

  function show(n) {
    slides[cur].classList.remove('active');
    dots[cur] && dots[cur].classList.remove('active');
    cur = n;
    slides[cur].classList.add('active');
    dots[cur] && dots[cur].classList.add('active');
  }

  function next(){ show((cur+1)%slides.length); }
  function start(){ t = setInterval(next, 5500); }
  function stop(){ clearInterval(t); }

  dots.forEach(function(d,i){
    d.addEventListener('click', function(){ show(i); stop(); start(); });
  });

  // Touch swipe on hero
  var hero = document.querySelector('.hero');
  if(hero){
    var tx=0;
    hero.addEventListener('touchstart',function(e){tx=e.changedTouches[0].screenX;},{passive:true});
    hero.addEventListener('touchend',function(e){
      var dx=e.changedTouches[0].screenX-tx;
      if(Math.abs(dx)>50){show(dx<0?(cur+1)%slides.length:(cur-1+slides.length)%slides.length);stop();start();}
    },{passive:true});
    hero.addEventListener('mouseenter',stop);
    hero.addEventListener('mouseleave',start);
  }

  start();

  // ── Parallax on hero background ──
  var parallax = document.getElementById('hero-parallax');
  if(parallax && window.matchMedia('(prefers-reduced-motion: no-preference)').matches){
    window.addEventListener('scroll', function(){
      var y = window.scrollY;
      parallax.style.transform = 'translateY(' + (y * 0.35) + 'px)';
    }, {passive: true});
  }
})();
</script>
