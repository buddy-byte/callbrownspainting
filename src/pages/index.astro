---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';

const keywords = 'painting contractor Brewton AL, residential painting Conecuh County, commercial painting Escambia County, interior painting Baldwin County, exterior painting South Alabama, house painter Evergreen AL, painting services Atmore AL, professional painter Monroeville AL';
---

<BaseLayout
  title="Professional Painting Services — Browns Painting LLC"
  description="Browns Painting LLC — South Alabama's trusted painting contractor since 1998. Interior, exterior, and commercial painting in Brewton, Evergreen, Fairhope, Mobile, and 20+ cities. Family-owned. 25+ years. 100% satisfaction guarantee."
  keywords={keywords}
>
  <main>

    <!-- ══════════════════════════════════════════
         HERO — full viewport, parallax, massive type
    ══════════════════════════════════════════════ -->
    <section class="hero" id="hero">
      <div class="hero-parallax" id="hero-parallax">
        <div class="slide active" style="background-image:url('/images/hero/hero-1-optimized.jpg')"></div>
        <div class="slide" style="background-image:url('/images/projects/projects-optimized/interior-painting-2-optimized.jpg')"></div>
        <div class="slide" style="background-image:url('/images/hero/hero-3-optimized.jpg');background-position:center top"></div>
      </div>

      <!-- Cinematic gradient overlay -->
      <div class="hero-grad"></div>
      <!-- Noise texture for depth -->
      <div class="hero-noise"></div>

      <div class="hero-content">
        <div class="hero-label">
          <span class="hero-label-dot"></span>
          Industry-Best Satisfaction Guarantee
        </div>

        <img src="/images/logo/browns-painting-logo-hat.png" alt="Browns Painting LLC" class="hero-logo" />

        <h1 class="hero-h1">
          <span class="hero-line1">Quality.</span>
          <em class="hero-line2">It's What We Do.</em>
        </h1>

        <p class="hero-sub">South Alabama's trusted painting contractor since 1998.<br/>Interior · Exterior · Commercial</p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn-primary">
            Get a Free Quote
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="tel:+12512374545" class="hero-btn-ghost">
            <svg width="15" height="15" viewBox="0 0 13 13" fill="none"><path d="M11.9 9.2c-.2-.2-1.9-1.3-2.2-1.3-.2 0-.4.1-.9.7-.2.2-.3.3-.4.3-.2 0-.4-.1-.7-.3-.8-.5-1.6-1.3-2.1-2.1-.3-.4-.4-.6-.4-.7 0-.1.1-.2.3-.4.5-.5.7-.7.7-.9 0-.2-1.1-2-1.3-2.2-.2-.2-.3-.2-.5-.2-.4 0-.9.2-1.2.6-.4.4-.6 1-.6 1.6 0 1 .5 2.2 1.3 3.2.7.9 1.9 2 2.9 2.6.8.5 1.9 1 2.8 1 .5 0 1.1-.2 1.5-.6.3-.3.6-.8.6-1.2 0-.2-.1-.4-.5-.8z" fill="currentColor"/></svg>
            (251) 237-4545
          </a>
        </div>

        <div class="hero-trust">
          <div class="trust-pill">★★★★★ 5-Star Rated</div>
          <div class="trust-pill">25+ Years Experience</div>
          <div class="trust-pill">Licensed &amp; Insured</div>
        </div>
      </div>

      <!-- Diagonal cut at bottom -->
      <div class="hero-cut"></div>

      <div class="hero-dots">
        <button class="dot active" data-idx="0"></button>
        <button class="dot" data-idx="1"></button>
        <button class="dot" data-idx="2"></button>
      </div>
    </section>


    <!-- ══════════════════════════════════════════
         STATS — compact dark strip
    ══════════════════════════════════════════════ -->
    <div class="stats-strip">
      <div class="stats-inner">
        <div class="stat">
          <strong>25+</strong>
          <span>Years in Business</span>
        </div>
        <div class="stat-rule"></div>
        <div class="stat">
          <strong>500+</strong>
          <span>Projects Completed</span>
        </div>
        <div class="stat-rule"></div>
        <div class="stat">
          <strong>3–7</strong>
          <span>Day Turnaround</span>
        </div>
        <div class="stat-rule"></div>
        <div class="stat">
          <strong>100%</strong>
          <span>Satisfaction Guarantee</span>
        </div>
      </div>
    </div>


    <!-- ══════════════════════════════════════════
         FEATURE — 2-col, framed photo, deep section
    ══════════════════════════════════════════════ -->
    <section class="feature-section">
      <div class="container feature-grid">

        <!-- Photo col with decorative frame -->
        <div class="feature-photo-col">
          <div class="feature-frame-accent"></div>
          <div class="feature-photo-stack">
            <img src="/images/Boomer/boomer-3-optimized.jpg" alt="Boomer Brown" class="feature-img-main" />
            <div class="feature-img-badge">
              <span class="badge-num">25+</span>
              <span class="badge-label">Years of<br/>Craft</span>
            </div>
            <div class="feature-img-float">
              <img src="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg" alt="Finished project" />
            </div>
          </div>
        </div>

        <!-- Content col -->
        <div class="feature-content">
          <span class="eyebrow">Who We Are</span>
          <h2 class="feature-h2">
            Professional Painting<br/>Results in As Little As
            <em>One Week!</em>
          </h2>
          <p>Your dream home is only one call away. Boomer Brown and his crew have been transforming homes and businesses across South Alabama for over 25 years. Family-owned, fully insured, built on old-fashioned accountability.</p>
          <p>We turn drab into dreamy — from your first call to the final walkthrough, quality is always top of mind. And it shows.</p>

          <div class="feature-checks">
            <div class="fcheck">
              <div class="fcheck-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              Free color consultation &amp; estimate
            </div>
            <div class="fcheck">
              <div class="fcheck-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              Premium weather-resistant paints
            </div>
            <div class="fcheck">
              <div class="fcheck-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              Meticulous prep &amp; thorough cleanup
            </div>
            <div class="fcheck">
              <div class="fcheck-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              100% satisfaction — or we come back
            </div>
          </div>

          <a href="/about" class="btn-solid">Our Story →</a>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════
         SERVICES — dark, magazine divider bar, cards ARE the section
    ══════════════════════════════════════════════ -->
    <section class="services-section">
      <div class="services-diag-top"></div>
      <div class="container">
        <!-- Minimal bar: eyebrow + title on ONE line, link on right — not a split -->
        <div class="svc-bar">
          <div class="svc-bar-left">
            <span class="eyebrow">Our Services</span>
            <h2 class="svc-bar-h2">What We Do</h2>
          </div>
          <a href="/services" class="svc-all-link">View All Services →</a>
        </div>

        <div class="svc-grid">

          <a href="/interior-painting" class="svc-card">
            <div class="svc-img-wrap">
              <img src="/images/projects/projects-optimized/interior-detail-1-optimized.jpg" alt="Interior Painting" loading="lazy" />
              <div class="svc-img-overlay"></div>
            </div>
            <div class="svc-body">
              <div class="svc-type">Interior</div>
              <h3 class="svc-title">Interior Painting</h3>
              <p>Flawless finishes for walls, ceilings, trim, and cabinets. Done right the first time.</p>
              <span class="svc-cta">Learn More <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </div>
          </a>

          <a href="/exterior-painting" class="svc-card svc-card-featured">
            <div class="svc-img-wrap">
              <img src="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg" alt="Exterior Painting" loading="lazy" />
              <div class="svc-img-overlay"></div>
            </div>
            <div class="svc-body">
              <div class="svc-type">Exterior</div>
              <h3 class="svc-title">Exterior Painting</h3>
              <p>Weather-resistant coatings built for Alabama's heat and humidity. Pressure washing, prep, and paint.</p>
              <span class="svc-cta">Learn More <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </div>
          </a>

          <a href="/commercial-painting" class="svc-card">
            <div class="svc-img-wrap svc-commercial-graphic">
              <!-- SVG paint stroke graphic background -->
              <svg class="svc-comm-svg" viewBox="0 0 400 270" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <!-- diagonal geometric lines for commercial/industrial feel -->
                <rect width="400" height="270" fill="#0a0d1a"/>
                <line x1="0" y1="270" x2="200" y2="0" stroke="rgba(245,158,11,0.07)" stroke-width="40"/>
                <line x1="100" y1="270" x2="300" y2="0" stroke="rgba(245,158,11,0.05)" stroke-width="40"/>
                <line x1="200" y1="270" x2="400" y2="0" stroke="rgba(245,158,11,0.04)" stroke-width="40"/>
                <line x1="300" y1="270" x2="500" y2="0" stroke="rgba(245,158,11,0.03)" stroke-width="40"/>
                <!-- paint roller icon -->
                <g transform="translate(150,90)">
                  <rect x="0" y="0" width="80" height="22" rx="4" stroke="rgba(245,158,11,0.35)" stroke-width="2" fill="none"/>
                  <rect x="5" y="5" width="70" height="12" rx="2" fill="rgba(245,158,11,0.12)"/>
                  <line x1="40" y1="22" x2="40" y2="44" stroke="rgba(245,158,11,0.3)" stroke-width="2"/>
                  <line x1="40" y1="44" x2="70" y2="44" stroke="rgba(245,158,11,0.3)" stroke-width="2"/>
                  <line x1="70" y1="44" x2="70" y2="55" stroke="rgba(245,158,11,0.3)" stroke-width="2.5"/>
                </g>
                <text x="200" y="180" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" letter-spacing="4" fill="rgba(245,158,11,0.3)">COMMERCIAL</text>
                <text x="200" y="197" text-anchor="middle" font-family="sans-serif" font-size="9" letter-spacing="2" fill="rgba(255,255,255,0.15)">LICENSED &amp; INSURED</text>
              </svg>
            </div>
            <div class="svc-body">
              <div class="svc-type">Commercial</div>
              <h3 class="svc-title">Commercial Painting</h3>
              <p>After-hours scheduling, minimal disruption, commercial-grade results for any business.</p>
              <span class="svc-cta">Learn More <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </div>
          </a>

        </div>
      </div>
      <div class="services-diag-bottom"></div>
    </section>


    <!-- ══════════════════════════════════════════
         TESTIMONIALS
    ══════════════════════════════════════════════ -->
    <Testimonials />


    <!-- ══════════════════════════════════════════
         WHY BROWNS — bold tile grid, big numbers, no split
    ══════════════════════════════════════════════ -->
    <section class="why-section">
      <div class="container">

        <!-- Section title: full-width, not a split, large and anchored -->
        <div class="why-header">
          <span class="eyebrow">Why Choose Browns</span>
          <h2 class="why-h2">Six Reasons Our Clients <em>Come Back.</em></h2>
          <a href="/about" class="why-learn-more">Meet the Team →</a>
        </div>

        <!-- 3×2 tile grid — big amber number + bold title + description -->
        <div class="why-tiles">

          <div class="why-tile">
            <span class="why-tile-num">01</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><path d="M14 3l2.8 8.6H25l-7.2 5.2 2.8 8.6L14 20.1l-6.6 5.3 2.8-8.6L3 11.6h8.2L14 3z" fill="currentColor" opacity=".25"/><path d="M14 3l2.8 8.6H25l-7.2 5.2 2.8 8.6L14 20.1l-6.6 5.3 2.8-8.6L3 11.6h8.2L14 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            </div>
            <h4>100% Satisfaction Guarantee</h4>
            <p>We don't call it done until you're happy. We come back and make it right, no questions asked.</p>
          </div>

          <div class="why-tile">
            <span class="why-tile-num">02</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><circle cx="11" cy="9" r="5" fill="currentColor" opacity=".25"/><circle cx="11" cy="9" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M2 24c0-4.4 4-8 9-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M19 17l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h4>Owner on Every Job</h4>
            <p>Boomer personally oversees every project. You get the owner on-site, not a sub-crew.</p>
          </div>

          <div class="why-tile">
            <span class="why-tile-num">03</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M14 8v6.5l3.5 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
            </div>
            <h4>3–7 Day Turnaround</h4>
            <p>Most projects done in one week. We show up when we say and finish when we say. Period.</p>
          </div>

          <div class="why-tile">
            <span class="why-tile-num">04</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><path d="M14 3L4 8.5v10L14 24l10-5.5v-10L14 3z" fill="currentColor" opacity=".15"/><path d="M14 3L4 8.5v10L14 24l10-5.5v-10L14 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.5 13.5l3 3 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h4>Licensed &amp; Fully Insured</h4>
            <p>Full Alabama licensing and liability on every job. Your home and investment are protected.</p>
          </div>

          <div class="why-tile">
            <span class="why-tile-num">05</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><rect x="3" y="10" width="22" height="15" rx="2" fill="currentColor" opacity=".15"/><rect x="3" y="10" width="22" height="15" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 10V7a6 6 0 0 1 12 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h4>Top-of-the-Line Paints</h4>
            <p>Premium, low-VOC, weather-resistant paints for Alabama's climate. No cutting corners.</p>
          </div>

          <div class="why-tile">
            <span class="why-tile-num">06</span>
            <div class="why-tile-icon">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><path d="M4 22V11L14 4l10 7v11H4z" fill="currentColor" opacity=".15"/><path d="M4 22V11L14 4l10 7v11H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 22v-7h8v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h4>25+ Years, Same Communities</h4>
            <p>We've painted for the same neighbors for decades. Our reputation is everything here.</p>
          </div>

        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════
         PROCESS — editorial large numbers, no centered header
    ══════════════════════════════════════════════ -->
    <section class="process-section">
      <div class="process-diag-top"></div>
      <div class="container">

        <!-- Top bar: left label only, no centered structure -->
        <div class="process-top-bar">
          <span class="eyebrow">How It Works</span>
          <h2 class="process-top-h2">Three Steps.<br/><em>Zero Stress.</em></h2>
        </div>

        <!-- Steps as editorial full-width cards -->
        <div class="process-cards">

          <div class="process-card">
            <div class="process-card-num">01</div>
            <div class="process-card-body">
              <div class="process-card-icon">
                <svg width="28" height="28" viewBox="0 0 30 30" fill="none"><rect x="3" y="5" width="24" height="21" rx="3" stroke="currentColor" stroke-width="2"/><path d="M9 3v4M21 3v4M3 13h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 18h12M9 22h7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </div>
              <h3>Get Your Quote</h3>
              <p>Call or fill out a form. We'll reach out within 24 hours for a free on-site estimate — no pressure, no obligation.</p>
            </div>
            <div class="process-card-cta">
              <a href="/contact">Request Quote →</a>
            </div>
          </div>

          <div class="process-card">
            <div class="process-card-num">02</div>
            <div class="process-card-body">
              <div class="process-card-icon">
                <svg width="28" height="28" viewBox="0 0 30 30" fill="none"><rect x="3" y="5" width="24" height="21" rx="3" stroke="currentColor" stroke-width="2"/><path d="M9 3v4M21 3v4M3 13h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="19" r="2" fill="currentColor"/><circle cx="15" cy="19" r="2" fill="currentColor"/></svg>
              </div>
              <h3>Get Scheduled</h3>
              <p>We work around your life. Confirm your date — we show up on time, protect your property, and get to work.</p>
            </div>
            <div class="process-card-cta process-card-cta--mid">
              <span>Usually 3–7 days out</span>
            </div>
          </div>

          <div class="process-card">
            <div class="process-card-num">03</div>
            <div class="process-card-body">
              <div class="process-card-icon">
                <svg width="28" height="28" viewBox="0 0 30 30" fill="none"><circle cx="15" cy="15" r="12" stroke="currentColor" stroke-width="2"/><path d="M9 15l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3>Relax &amp; Enjoy</h3>
              <p>We handle all prep, painting, and complete cleanup. You walk through, approve, and enjoy the transformation.</p>
            </div>
            <div class="process-card-cta process-card-cta--done">
              <span>100% satisfaction or we return</span>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════
         AREAS — asymmetric: left tall label + right county grid
    ══════════════════════════════════════════════ -->
    <section class="areas-section">
      <div class="container areas-split">

        <!-- LEFT: county grid (content IS the section) -->
        <div class="areas-grid">
          <div class="area-card">
            <h4>Escambia</h4>
            <a href="/brewton-painting">Brewton</a>
            <a href="/atmore-painting">Atmore</a>
            <a href="/flomaton-painting">Flomaton</a>
          </div>
          <div class="area-card">
            <h4>Conecuh</h4>
            <a href="/evergreen-painting">Evergreen</a>
            <a href="/castleberry-painting">Castleberry</a>
            <a href="/evergreen-painting">Repton</a>
          </div>
          <div class="area-card">
            <h4>Monroe</h4>
            <a href="/monroeville-painting">Monroeville</a>
            <a href="/monroeville-painting">Frisco City</a>
          </div>
          <div class="area-card">
            <h4>Mobile</h4>
            <a href="/mobile-painting">Mobile</a>
            <a href="/saraland-painting">Saraland</a>
            <a href="/theodore-painting">Theodore</a>
            <a href="/creola-painting">Creola</a>
          </div>
          <div class="area-card area-card-wide">
            <h4>Baldwin</h4>
            <div class="area-cities-grid">
              <a href="/fairhope-painting">Fairhope</a>
              <a href="/daphne-painting">Daphne</a>
              <a href="/gulf-shores-painting">Gulf Shores</a>
              <a href="/orange-beach-painting">Orange Beach</a>
              <a href="/foley-painting">Foley</a>
              <a href="/bay-minette-painting">Bay Minette</a>
            </div>
          </div>
        </div><!-- end areas-grid -->

        <!-- RIGHT: label, stats, CTA (flipped from left-label pattern) -->
        <div class="areas-right">
          <span class="eyebrow">Where We Serve</span>
          <h2 class="areas-big-h2">South<br/>Alabama's<br/><span class="h2-accent">Painters.</span></h2>
          <div class="areas-stats">
            <div class="areas-stat"><strong>5</strong><span>Counties</span></div>
            <div class="areas-stat"><strong>20+</strong><span>Cities</span></div>
          </div>
          <p class="areas-right-desc">One crew you can trust — licensed, insured, and locally rooted for 25+ years.</p>
          <a href="/service-areas" class="btn-outline-white areas-cta-btn">All Service Areas →</a>
        </div>

      </div>
    </section>


    <!-- ══════════════════════════════════════════
         CTA STRIP — amber, full contrast
    ══════════════════════════════════════════════ -->
    <section class="cta-strip">
      <div class="container cta-strip-inner">
        <div class="cta-text-block">
          <span class="cta-pre">Ready to Start?</span>
          <h2 class="cta-h2">Get BROWNS Today!</h2>
          <p>Our painters will turn the mundane into beautiful. Transform your home or business.</p>
        </div>
        <a href="/contact" class="cta-dark-btn">
          Get Free Estimate
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>


<style>
