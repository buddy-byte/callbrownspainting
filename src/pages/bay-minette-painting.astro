---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Bay Minette Painting', url: '/bay-minette-painting' }
];
---

<BaseLayout
  title="Painting Services in Bay Minette, AL | Browns Painting LLC"
  description="Professional painting services in Bay Minette, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Bay Minette AL, house painter Bay Minette Alabama, Baldwin County painting services, interior painting Bay Minette, exterior painting Bay Minette"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Bay Minette AL"
    serviceDescription="Expert painting services in Bay Minette, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/bay-minette-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Bay Minette"
      county="Baldwin County"
      slug="bay-minette"
      nearbyLinks={[
  { name: 'Daphne', url: '/daphne-painting' },
  { name: 'Fairhope', url: '/fairhope-painting' },
  { name: 'Loxley', url: '/loxley-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
