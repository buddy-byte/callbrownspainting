---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Theodore Painting', url: '/theodore-painting' }
];
---

<BaseLayout
  title="Painting Services in Theodore, AL | Browns Painting LLC"
  description="Professional painting services in Theodore, Alabama. Interior, exterior, and commercial painting by Browns Painting — Mobile County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Theodore AL, house painter Theodore Alabama, Mobile County painting services, interior painting Theodore, exterior painting Theodore"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Theodore AL"
    serviceDescription="Expert painting services in Theodore, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/theodore-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Theodore"
      county="Mobile County"
      slug="theodore"
      nearbyLinks={[
  { name: 'Mobile', url: '/mobile-painting' },
  { name: 'Saraland', url: '/saraland-painting' },
  { name: 'Daphne', url: '/daphne-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
