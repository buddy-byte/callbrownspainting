---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Foley Painting', url: '/foley-painting' }
];
---

<BaseLayout
  title="Painting Services in Foley, AL | Browns Painting LLC"
  description="Professional painting services in Foley, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Foley AL, house painter Foley Alabama, Baldwin County painting services, interior painting Foley, exterior painting Foley"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Foley AL"
    serviceDescription="Expert painting services in Foley, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/foley-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Foley"
      county="Baldwin County"
      slug="foley"
      nearbyLinks={[
  { name: 'Gulf Shores', url: '/gulf-shores-painting' },
  { name: 'Orange Beach', url: '/orange-beach-painting' },
  { name: 'Fairhope', url: '/fairhope-painting' },
  { name: 'Summerdale', url: '/summerdale-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
