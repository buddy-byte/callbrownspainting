---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Application Received! | Browns Painting Careers";
const description = "Thank you for applying to Browns Painting. We'll review your application and get back to you soon.";
---

<BaseLayout title={title} description={description}>
  <main>
    <section style="position: relative; padding: 8rem 0; min-height: 80vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
      <!-- Background Image -->
      <div style="position: absolute; inset: 0; z-index: 0;">
        <img src="/images/hero/hero-2-optimized.jpg" alt="Browns Painting Team" style="width: 100%; height: 100%; object-fit: cover;">
        <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(16, 185, 129, 0.92) 0%, rgba(5, 150, 105, 0.92) 100%);"></div>
      </div>
      
      <div style="position: relative; z-index: 1; max-width: 800px; margin: 0 auto; padding: 0 2rem; text-align: center; color: white;">
        <div style="font-size: 5rem; margin-bottom: 2rem;">✓</div>
        <h1 style="font-size: 3.5rem; font-weight: 900; margin-bottom: 1.5rem; color: white;">Application Received!</h1>
        <p style="font-size: 1.5rem; margin-bottom: 2rem; opacity: 0.95; line-height: 1.6;">
          Thanks for your interest in joining Browns Painting! We've received your application and will review it carefully. Boomer will get back to you as soon as possible.
        </p>
        
        <div style="background: rgba(255, 255, 255, 0.1); padding: 2rem; border-radius: 16px; margin: 3rem 0; backdrop-filter: blur(10px); border: 2px solid rgba(255, 255, 255, 0.2);">
          <p style="font-size: 1.25rem; margin-bottom: 1rem; font-weight: 600;">Have questions? Call us directly</p>
          <a href="tel:+12512374545" style="font-size: 2rem; color: #fbbf24; text-decoration: none; font-weight: 700; display: block; margin-bottom: 0.5rem;">(251) 237-4545</a>
          <p style="font-size: 1rem; opacity: 0.9;">We're always happy to chat about opportunities</p>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 3rem;">
          <a href="/" style="display: inline-flex; align-items: center; gap: 0.75rem; padding: 1.25rem 2.5rem; background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #1f2937; text-decoration: none; font-weight: 700; transition: all 0.3s ease; font-size: 1.125rem; text-transform: uppercase; letter-spacing: 0.5px; border-radius: 12px; box-shadow: 0 8px 25px rgba(251, 191, 36, 0.4);">
            ← Back to Home
          </a>
          <a href="/careers" style="display: inline-flex; align-items: center; gap: 0.75rem; padding: 1.25rem 2.5rem; background: rgba(255, 255, 255, 0.2); color: white; text-decoration: none; font-weight: 700; transition: all 0.3s ease; font-size: 1.125rem; text-transform: uppercase; letter-spacing: 0.5px; border-radius: 12px; backdrop-filter: blur(10px); border: 2px solid rgba(255, 255, 255, 0.3);">
            View Careers Page
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

