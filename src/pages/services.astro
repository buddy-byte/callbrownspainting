---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import Testimonials from '../components/Testimonials.astro';

const title = "Professional Painting Services | Browns Painting South Alabama";
const description = "Complete interior and exterior painting services for homes and businesses. 25+ years serving South Alabama. Free estimates. (251) 237-4545";
---

<BaseLayout title={title} description={description}>
  <main>

    <InnerPageHero
      title="Professional Painting Services"
      subtitle="Interior, exterior, and commercial painting backed by 25+ years of South Alabama experience."
      eyebrow="What We Do"
      bg="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg"
    />

    <!-- ── SERVICES GRID ── -->
    <section class="svc-page-section">
      <div class="container">
        <div class="svc-page-header">
          <span class="eyebrow">Our Services</span>
          <h2 class="svc-page-h2">Every Job, Done Right.</h2>
          <p class="svc-page-intro">From single rooms to commercial facilities, we bring 25+ years of craft to every project. Owner on site. Results guaranteed.</p>
        </div>

        <div class="svc-page-grid">

          <a href="/interior-painting" class="svc-page-card">
            <div class="svc-page-img-wrap">
              <img src="/images/projects/projects-optimized/interior-detail-1-optimized.jpg" alt="Interior Painting" loading="lazy" />
              <div class="svc-page-img-ov"></div>
            </div>
            <div class="svc-page-body">
              <div class="svc-page-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
              </div>
              <div class="svc-page-type">Interior</div>
              <h3>Interior Painting</h3>
              <p>Flawless finishes for walls, ceilings, trim, and cabinets. Expert prep, low-VOC paints, and meticulous cleanup.</p>
              <ul class="svc-check-list">
                <li>Living rooms &amp; bedrooms</li>
                <li>Kitchens &amp; bathrooms</li>
                <li>Cabinet refinishing</li>
                <li>Free color consultation</li>
              </ul>
              <span class="svc-page-cta">Learn More →</span>
            </div>
          </a>

          <a href="/exterior-painting" class="svc-page-card svc-page-card-featured">
            <div class="svc-page-img-wrap">
              <img src="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg" alt="Exterior Painting" loading="lazy" />
              <div class="svc-page-img-ov"></div>
            </div>
            <div class="svc-page-body">
              <div class="svc-page-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </div>
              <div class="svc-page-type">Exterior</div>
              <h3>Exterior Painting</h3>
              <p>Weather-resistant coatings built for Alabama's heat and humidity. Pressure washing, prep, primer, and premium paint.</p>
              <ul class="svc-check-list">
                <li>Siding &amp; trim</li>
                <li>Deck &amp; fence staining</li>
                <li>Pressure washing</li>
                <li>Storm-damage recovery</li>
              </ul>
              <span class="svc-page-cta">Learn More →</span>
            </div>
          </a>

          <a href="/commercial-painting" class="svc-page-card">
            <div class="svc-page-img-wrap svc-comm-graphic">
              <svg viewBox="0 0 400 270" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%;position:absolute;top:0;left:0;">
                <rect width="400" height="270" fill="#0a0d1a"/>
                <line x1="-50" y1="320" x2="320" y2="-50" stroke="rgba(245,158,11,0.07)" stroke-width="40"/>
                <line x1="0" y1="320" x2="370" y2="-50" stroke="rgba(245,158,11,0.05)" stroke-width="40"/>
                <line x1="-100" y1="320" x2="270" y2="-50" stroke="rgba(245,158,11,0.04)" stroke-width="40"/>
                <text x="200" y="100" text-anchor="middle" font-size="11" font-weight="700" letter-spacing="4" fill="rgba(245,158,11,0.5)" font-family="system-ui">COMMERCIAL</text>
                <text x="200" y="118" text-anchor="middle" font-size="9" font-weight="600" letter-spacing="3" fill="rgba(255,255,255,0.2)" font-family="system-ui">LICENSED &amp; INSURED</text>
                <rect x="170" y="135" width="60" height="50" rx="4" fill="none" stroke="rgba(245,158,11,0.35)" stroke-width="1.5"/>
                <rect x="183" y="148" width="14" height="18" rx="2" fill="none" stroke="rgba(245,158,11,0.4)" stroke-width="1.5"/>
                <rect x="203" y="148" width="14" height="18" rx="2" fill="none" stroke="rgba(245,158,11,0.4)" stroke-width="1.5"/>
                <rect x="162" y="135" width="76" height="6" rx="2" fill="rgba(245,158,11,0.25)"/>
              </svg>
            </div>
            <div class="svc-page-body">
              <div class="svc-page-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18M2 22h20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 12h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </div>
              <div class="svc-page-type">Commercial</div>
              <h3>Commercial Painting</h3>
              <p>After-hours scheduling, minimal disruption, and commercial-grade results for any business or facility.</p>
              <ul class="svc-check-list">
                <li>Offices &amp; retail</li>
                <li>Churches &amp; schools</li>
                <li>After-hours service</li>
                <li>Multi-unit projects</li>
              </ul>
              <span class="svc-page-cta">Learn More →</span>
            </div>
          </a>

          <a href="/house-painter" class="svc-page-card">
            <div class="svc-page-img-wrap">
              <img src="/images/projects/projects-optimized/brewton-exterior-1-optimized.jpg" alt="Residential Painting" loading="lazy" />
              <div class="svc-page-img-ov"></div>
            </div>
            <div class="svc-page-body">
              <div class="svc-page-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 22V12h6v10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </div>
              <div class="svc-page-type">Residential</div>
              <h3>Whole-Home Painting</h3>
              <p>Full interior and exterior makeovers from single rooms to complete home renovations and new construction.</p>
              <ul class="svc-check-list">
                <li>Whole-house makeovers</li>
                <li>New construction</li>
                <li>Renovation projects</li>
                <li>Single-room refresh</li>
              </ul>
              <span class="svc-page-cta">Learn More →</span>
            </div>
          </a>

          <a href="/emergency-painting" class="svc-page-card">
            <div class="svc-page-img-wrap">
              <img src="/images/projects/projects-optimized/exterior-stucco-1-optimized.jpg" alt="Emergency Painting" loading="lazy" />
              <div class="svc-page-img-ov"></div>
            </div>
            <div class="svc-page-body">
              <div class="svc-page-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.75"/><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="svc-page-type">Emergency</div>
              <h3>Emergency &amp; Urgent Work</h3>
              <p>Storm damage, insurance claims, and urgent repair painting. Fast response when you need it most.</p>
              <ul class="svc-check-list">
                <li>Storm damage repair</li>
                <li>Insurance work</li>
                <li>Rapid response</li>
                <li>Temporary protection</li>
              </ul>
              <span class="svc-page-cta">Learn More →</span>
            </div>
          </a>

          <!-- CTA Card -->
          <div class="svc-page-cta-card">
            <span class="eyebrow" style="color:var(--amber)">Free Estimates</span>
            <h3>Ready to Get Started?</h3>
            <p>Call Boomer directly or fill out our quick quote form. We respond within 24 hours.</p>
            <a href="/contact" class="btn-amber">Get a Free Quote →</a>
            <a href="tel:+12512374545" class="svc-cta-phone">(251) 237-4545</a>
          </div>

        </div>
      </div>
    </section>

    <!-- ── PROCESS ── -->
    <section class="svc-process-section">
      <div class="container">
        <div class="svc-process-header">
          <span class="eyebrow">How It Works</span>
          <h2 class="svc-process-h2">Three Steps. <em>Zero Stress.</em></h2>
        </div>
        <div class="svc-process-grid">
          <div class="svc-proc-card">
            <span class="svc-proc-num">01</span>
            <div class="svc-proc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
            </div>
            <h4>Get Your Quote</h4>
            <p>Call or fill out the form. We schedule a free on-site estimate within 24 hours — no pressure, no obligation.</p>
            <a href="/contact" class="svc-proc-link">Request Quote →</a>
          </div>
          <div class="svc-proc-card">
            <span class="svc-proc-num">02</span>
            <div class="svc-proc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
            </div>
            <h4>Get Scheduled</h4>
            <p>We work around your life. Confirm your date and we show up on time, protect your property, and get to work.</p>
            <span class="svc-proc-tag">Usually 3–7 days out</span>
          </div>
          <div class="svc-proc-card">
            <span class="svc-proc-num">03</span>
            <div class="svc-proc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h4>Relax &amp; Enjoy</h4>
            <p>We handle all prep, painting, and complete cleanup. Walk through, approve, and enjoy the transformation.</p>
            <span class="svc-proc-tag" style="color:var(--amber)">100% satisfaction or we return</span>
          </div>
        </div>
      </div>
    </section>

    <Testimonials />

    <!-- ── CTA STRIP ── -->
    <section class="svc-cta-strip">
      <div class="container svc-cta-inner">
        <div>
          <h2 class="svc-cta-h2">South Alabama's Painting Contractor.<br/><em>Since 1998.</em></h2>
          <p>Licensed, insured, and family-owned. Boomer shows up personally on every job.</p>
        </div>
        <a href="/contact" class="btn-dark">Get Your Free Estimate →</a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  /* ── Eyebrow ── */
  .eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--amber);
  }

  /* ── Shared buttons ── */
  .btn-amber {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: var(--amber); color: var(--ink);
    font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800;
    text-decoration: none; border-radius: var(--radius-md);
    transition: background 0.2s, transform 0.2s;
    box-shadow: var(--shadow-amber);
  }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  .btn-dark {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 1rem 2.25rem;
    background: var(--ink); color: #fff;
    font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800;
    text-decoration: none; border-radius: var(--radius-md);
    border: 1.5px solid rgba(255,255,255,0.15);
    transition: background 0.2s;
    white-space: nowrap;
  }
  .btn-dark:hover { background: #1a2535; }

  /* ── SERVICES GRID SECTION ── */
  .svc-page-section {
    background: var(--cream);
    padding: 5rem 0 6rem;
  }

  .svc-page-header {
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 640px;
  }

  .svc-page-h2 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--ink);
    margin: 0;
  }

  .svc-page-intro {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 560px;
  }

  .svc-page-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5px;
    background: var(--border);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .svc-page-card {
    background: var(--white);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .svc-page-card:hover { background: #faf8f5; }
  .svc-page-card-featured { grid-row: span 1; }

  .svc-page-img-wrap {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: var(--ink);
    flex-shrink: 0;
  }

  .svc-comm-graphic { background: #0a0d1a; }

  .svc-page-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    filter: brightness(1.05) saturate(1.2);
  }

  .svc-page-card:hover .svc-page-img-wrap img { transform: scale(1.05); }

  .svc-page-img-ov {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(17,24,39,0.6) 0%, rgba(17,24,39,0.1) 60%, transparent 100%);
  }

  .svc-page-body {
    padding: 1.75rem 1.75rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .svc-page-icon {
    width: 44px; height: 44px;
    background: rgba(245,158,11,0.1);
    border: 1px solid rgba(245,158,11,0.2);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: var(--amber);
    flex-shrink: 0;
    margin-bottom: 0.25rem;
  }

  .svc-page-type {
    font-family: var(--font-sans);
    font-size: 0.625rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--amber);
  }

  .svc-page-card h3 {
    font-family: var(--font-sans);
    font-size: 1.25rem; font-weight: 900;
    letter-spacing: -0.03em; line-height: 1.2;
    color: var(--ink); margin: 0;
  }

  .svc-page-card p {
    font-family: var(--font-sans);
    font-size: 0.875rem; color: var(--text-muted);
    line-height: 1.65; margin: 0;
  }

  .svc-check-list {
    list-style: none; padding: 0; margin: 0.25rem 0 0;
    display: flex; flex-direction: column; gap: 0.375rem;
  }

  .svc-check-list li {
    font-family: var(--font-sans);
    font-size: 0.8125rem; color: var(--text-muted);
    padding-left: 1.25rem; position: relative;
  }

  .svc-check-list li::before {
    content: '✓';
    position: absolute; left: 0;
    color: var(--amber); font-weight: 700;
  }

  .svc-page-cta {
    font-family: var(--font-sans);
    font-size: 0.8125rem; font-weight: 800;
    color: var(--amber); margin-top: auto;
    padding-top: 0.75rem;
  }

  /* CTA card in grid */
  .svc-page-cta-card {
    background: var(--ink);
    padding: 2rem 1.75rem;
    display: flex; flex-direction: column; gap: 1rem;
    justify-content: center;
  }

  .svc-page-cta-card h3 {
    font-family: var(--font-sans);
    font-size: 1.375rem; font-weight: 900;
    letter-spacing: -0.03em; color: #fff; margin: 0;
  }

  .svc-page-cta-card p {
    font-family: var(--font-sans);
    font-size: 0.875rem; color: rgba(255,255,255,0.5);
    line-height: 1.6; margin: 0;
  }

  .svc-cta-phone {
    font-family: var(--font-sans);
    font-size: 1.125rem; font-weight: 900;
    letter-spacing: -0.02em; color: rgba(255,255,255,0.4);
    text-decoration: none;
  }

  .svc-cta-phone:hover { color: var(--amber); }

  /* ── PROCESS ── */
  .svc-process-section {
    background: var(--ink-soft);
    padding: 5rem 0 6rem;
  }

  .svc-process-header {
    display: flex; flex-direction: column; gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .svc-process-h2 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 900; letter-spacing: -0.04em; line-height: 1.05;
    color: #fff; margin: 0;
  }

  .svc-process-h2 em {
    font-family: var(--font-display);
    font-style: italic; font-weight: 400;
    color: var(--amber); letter-spacing: -0.02em;
  }

  .svc-process-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5px; background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-xl); overflow: hidden;
  }

  .svc-proc-card {
    background: var(--ink-soft);
    padding: 2.5rem 2rem 2.25rem;
    display: flex; flex-direction: column; gap: 0.875rem;
    position: relative;
  }

  .svc-proc-num {
    position: absolute; top: 1.5rem; right: 1.75rem;
    font-family: var(--font-sans); font-size: 4rem; font-weight: 900;
    letter-spacing: -0.05em; line-height: 1;
    color: rgba(245,158,11,0.1); pointer-events: none; user-select: none;
  }

  .svc-proc-icon {
    width: 52px; height: 52px;
    background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);
    border-radius: 14px; display: flex; align-items: center; justify-content: center;
    color: var(--amber);
  }

  .svc-proc-card h4 {
    font-family: var(--font-sans);
    font-size: 1.125rem; font-weight: 800;
    color: #fff; letter-spacing: -0.025em; margin: 0;
  }

  .svc-proc-card p {
    font-family: var(--font-sans);
    font-size: 0.875rem; color: rgba(255,255,255,0.5);
    line-height: 1.65; margin: 0;
  }

  .svc-proc-link, .svc-proc-tag {
    font-family: var(--font-sans);
    font-size: 0.8125rem; font-weight: 800;
    color: var(--amber); text-decoration: none; margin-top: auto;
  }

  /* ── CTA STRIP ── */
  .svc-cta-strip {
    background: var(--amber);
    padding: 4rem 0;
  }

  .svc-cta-inner {
    display: flex; align-items: center;
    justify-content: space-between; gap: 3rem;
  }

  .svc-cta-h2 {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 900; letter-spacing: -0.04em; line-height: 1.1;
    color: var(--ink); margin: 0 0 0.5rem;
  }

  .svc-cta-h2 em {
    font-family: var(--font-display);
    font-style: italic; font-weight: 400; letter-spacing: -0.02em;
  }

  .svc-cta-strip p {
    font-family: var(--font-sans);
    font-size: 1rem; color: rgba(17,24,39,0.7); margin: 0;
  }

  @media (max-width: 900px) {
    .svc-page-grid { grid-template-columns: repeat(2, 1fr); }
    .svc-process-grid { grid-template-columns: 1fr; }
    .svc-cta-inner { flex-direction: column; text-align: center; }
  }

  @media (max-width: 640px) {
    .svc-page-grid { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
