---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';

const counties = [
  {
    name: 'Escambia County',
    cities: [
      { name: 'Brewton', url: '/brewton-painting' },
      { name: 'Atmore', url: '/atmore-painting' },
      { name: 'Flomaton', url: '/flomaton-painting' },
    ]
  },
  {
    name: 'Conecuh County',
    cities: [
      { name: 'Evergreen', url: '/evergreen-painting' },
      { name: 'Castleberry', url: '/castleberry-painting' },
      { name: 'Repton', url: '/repton-painting' },
      { name: 'Lenox', url: '/lenox-painting' },
    ]
  },
  {
    name: 'Monroe County',
    cities: [
      { name: 'Monroeville', url: '/monroeville-painting' },
      { name: 'Frisco City', url: '/service-areas' },
    ]
  },
  {
    name: 'Mobile County',
    cities: [
      { name: 'Mobile', url: '/mobile-painting' },
      { name: 'Saraland', url: '/saraland-painting' },
      { name: 'Theodore', url: '/theodore-painting' },
      { name: 'Creola', url: '/creola-painting' },
    ]
  },
  {
    name: 'Baldwin County',
    cities: [
      { name: 'Fairhope', url: '/fairhope-painting' },
      { name: 'Daphne', url: '/daphne-painting' },
      { name: 'Gulf Shores', url: '/gulf-shores-painting' },
      { name: 'Orange Beach', url: '/orange-beach-painting' },
      { name: 'Foley', url: '/foley-painting' },
      { name: 'Bay Minette', url: '/bay-minette-painting' },
      { name: 'Loxley', url: '/loxley-painting' },
      { name: 'Robertsdale', url: '/robertsdale-painting' },
      { name: 'Silverhill', url: '/silverhill-painting' },
      { name: 'Summerdale', url: '/summerdale-painting' },
    ]
  },
];
---

<BaseLayout
  title="Service Areas — Browns Painting LLC | South Alabama"
  description="Browns Painting serves Escambia, Conecuh, Monroe, Mobile, and Baldwin Counties across South Alabama. 20+ cities. Licensed and insured."
>
  <main>
    <InnerPageHero
      title="Where We Serve"
      subtitle="One crew you can trust, across 5 counties and 20+ cities throughout South Alabama."
      eyebrow="Service Areas"
      bg="/images/hero/hero-1-optimized.jpg"
    />

    <!-- ── COUNTIES ── -->
    <section class="areas-page-section">
      <div class="container">
        <div class="areas-page-header">
          <span class="eyebrow">Coverage</span>
          <h2 class="areas-page-h2">South Alabama's <em>Painters.</em></h2>
          <p class="areas-page-intro">From Brewton to the Gulf Coast, we bring the same family-owned quality and personal accountability to every job.</p>
        </div>

        <div class="areas-counties-grid">
          {counties.map((county) => (
            <div class="county-block">
              <div class="county-block-header">
                <span class="county-name">{county.name}</span>
              </div>
              <ul class="county-cities">
                {county.cities.map((city) => (
                  <li><a href={city.url}>{city.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Stats strip -->
        <div class="areas-stats-strip">
          <div class="areas-stat">
            <strong>5</strong>
            <span>Counties</span>
          </div>
          <div class="areas-stat">
            <strong>20+</strong>
            <span>Cities</span>
          </div>
          <div class="areas-stat">
            <strong>25+</strong>
            <span>Years Serving AL</span>
          </div>
          <div class="areas-stat">
            <strong>500+</strong>
            <span>Projects Completed</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ── NOT YOUR CITY? ── -->
    <section class="areas-ask-section">
      <div class="container areas-ask-inner">
        <div>
          <span class="eyebrow">Don't see your city?</span>
          <h2 class="areas-ask-h2">We May Still Serve You.</h2>
          <p>Call Boomer directly — we frequently travel to surrounding areas and can often accommodate projects outside our standard coverage zone.</p>
        </div>
        <div class="areas-ask-btns">
          <a href="/contact" class="btn-amber">Get in Touch →</a>
          <a href="tel:+12512361411" class="areas-ask-phone">(251) 236-1411</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .eyebrow { display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }
  .btn-amber { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--amber); color: var(--ink); font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s; }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  .areas-page-section { background: var(--cream); padding: 5.5rem 0 5rem; }

  .areas-page-header { max-width: 640px; margin-bottom: 3.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .areas-page-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }
  .areas-page-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber-deep); letter-spacing: -0.02em; }
  .areas-page-intro { font-family: var(--font-sans); font-size: 1.0625rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  .areas-counties-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; margin-bottom: 2rem; }

  .county-block { background: var(--white); padding: 2rem 1.75rem; }

  .county-block-header { margin-bottom: 1.25rem; padding-bottom: 0.875rem; border-bottom: 1px solid var(--border); }

  .county-name { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: var(--amber); }

  .county-cities { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }

  .county-cities li a { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 600; color: var(--text); text-decoration: none; transition: color 0.2s; display: flex; align-items: center; gap: 0.5rem; }
  .county-cities li a::before { content: '→'; font-size: 0.75rem; color: var(--amber); opacity: 0; transition: opacity 0.2s, transform 0.2s; transform: translateX(-4px); }
  .county-cities li a:hover { color: var(--amber-deep); }
  .county-cities li a:hover::before { opacity: 1; transform: translateX(0); }

  .areas-stats-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }

  .areas-stat { background: var(--ink); padding: 2rem 1.5rem; text-align: center; display: flex; flex-direction: column; gap: 0.375rem; }
  .areas-stat strong { font-family: var(--font-sans); font-size: 2.25rem; font-weight: 900; letter-spacing: -0.04em; color: var(--amber); line-height: 1; }
  .areas-stat span { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); }

  .areas-ask-section { background: var(--ink-soft); padding: 5rem 0; }
  .areas-ask-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .areas-ask-h2 { font-family: var(--font-sans); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 900; letter-spacing: -0.04em; color: #fff; margin: 0.375rem 0 0.75rem; }
  .areas-ask-section p { font-family: var(--font-sans); font-size: 1rem; color: rgba(255,255,255,0.45); line-height: 1.65; margin: 0; max-width: 540px; }
  .areas-ask-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .areas-ask-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: rgba(255,255,255,0.35); text-decoration: none; white-space: nowrap; }
  .areas-ask-phone:hover { color: var(--amber); }

  @media (max-width: 900px) {
    .areas-counties-grid { grid-template-columns: repeat(2, 1fr); }
    .areas-stats-strip { grid-template-columns: repeat(2, 1fr); }
    .areas-ask-inner { flex-direction: column; text-align: center; align-items: flex-start; }
    .areas-ask-btns { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .areas-counties-grid { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
