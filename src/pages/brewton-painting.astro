---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Brewton Painting', url: '/brewton-painting' }
];
---

<BaseLayout
  title="Painting Services in Brewton, AL | Browns Painting LLC"
  description="Professional painting services in Brewton, Alabama. Interior, exterior, and commercial painting by Browns Painting — Escambia County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Brewton AL, house painter Brewton Alabama, Escambia County painting services, interior painting Brewton, exterior painting Brewton"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Brewton AL"
    serviceDescription="Expert painting services in Brewton, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/brewton-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Brewton"
      county="Escambia County"
      slug="brewton"
      nearbyLinks={[
  { name: 'Atmore', url: '/atmore-painting' },
  { name: 'Flomaton', url: '/flomaton-painting' },
  { name: 'Evergreen', url: '/evergreen-painting' },
  { name: 'Monroeville', url: '/monroeville-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
