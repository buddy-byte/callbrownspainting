---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import Testimonials from '../components/Testimonials.astro';

const title = "Interior Painting Services | Professional Painters South Alabama";
const description = "Transform your indoor spaces with expert interior painting. Serving Mobile, Daphne, Fairhope, Gulf Shores, and surrounding South Alabama areas.";
---

<BaseLayout title={title} description={description}>
  <main>

    <InnerPageHero
      title="Interior Painting Services"
      subtitle="Flawless walls, ceilings, trim, and cabinets — done right the first time."
      eyebrow="Interior Painting"
      bg="/images/projects/projects-optimized/interior-detail-1-optimized.jpg"
    />

    <!-- ── WHAT WE OFFER ── -->
    <section class="ip-section ip-cream">
      <div class="container">
        <div class="ip-split">
          <div class="ip-split-content">
            <span class="eyebrow">What We Do</span>
            <h2 class="ip-h2">Every Room, <em>Perfected.</em></h2>
            <p>From prep work to final walkthrough, we treat your home like our own. We use premium, low-VOC paints and leave every job spotless.</p>
            <ul class="ip-feature-list">
              <li>
                <div class="ip-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg></div>
                <div><strong>Living Rooms &amp; Bedrooms</strong><p>Complete wall, ceiling, and trim work with expert edge cutting and full prep.</p></div>
              </li>
              <li>
                <div class="ip-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div><strong>Kitchens &amp; Bathrooms</strong><p>Moisture-resistant paints, precise masking, and smooth finishes in hard-to-reach areas.</p></div>
              </li>
              <li>
                <div class="ip-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></div>
                <div><strong>Cabinet Refinishing</strong><p>Transform dated cabinets with a smooth factory-like finish at a fraction of replacement cost.</p></div>
              </li>
              <li>
                <div class="ip-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.75"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></div>
                <div><strong>Free Color Consultation</strong><p>Not sure what color to choose? Boomer helps you find the perfect palette for your space.</p></div>
              </li>
            </ul>
            <a href="/contact" class="btn-amber">Get a Free Interior Quote →</a>
          </div>
          <div class="ip-split-img">
            <img src="/images/projects/projects-optimized/interior-painting-1-optimized.jpg" alt="Interior painting in progress" loading="lazy" />
            <div class="ip-img-badge">
              <strong>25+</strong>
              <span>Years of Craft</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── WHAT SETS US APART ── -->
    <section class="ip-section ip-dark">
      <div class="container">
        <div class="ip-section-top">
          <span class="eyebrow">Why Browns</span>
          <h2 class="ip-h2 ip-h2-white">Our Interior Painting <em>Standards.</em></h2>
        </div>
        <div class="ip-standards-grid">
          <div class="ip-standard">
            <div class="ip-std-num">01</div>
            <h4>Meticulous Prep Work</h4>
            <p>We fill holes, sand surfaces, tape off trim, and protect your floors before a single brush stroke. Proper prep = lasting results.</p>
          </div>
          <div class="ip-standard">
            <div class="ip-std-num">02</div>
            <h4>Premium Paint Only</h4>
            <p>We use Sherwin-Williams and comparable top-tier paints. Low-VOC formulas safe for families and pets.</p>
          </div>
          <div class="ip-standard">
            <div class="ip-std-num">03</div>
            <h4>Clean Job Site, Every Time</h4>
            <p>We clean up completely at the end of every day and do a full site cleanup before your walkthrough.</p>
          </div>
          <div class="ip-standard">
            <div class="ip-std-num">04</div>
            <h4>Owner on Every Job</h4>
            <p>Boomer personally oversees every interior project. You're not getting a sub-crew — you're getting the owner.</p>
          </div>
          <div class="ip-standard">
            <div class="ip-std-num">05</div>
            <h4>100% Satisfaction</h4>
            <p>We don't call it done until you're completely happy. We'll come back and touch up anything that's not right.</p>
          </div>
          <div class="ip-standard">
            <div class="ip-std-num">06</div>
            <h4>Competitive Pricing</h4>
            <p>Free estimates, transparent pricing, no hidden fees. We work within your budget without sacrificing quality.</p>
          </div>
        </div>
      </div>
    </section>

    <Testimonials />

    <!-- ── CTA ── -->
    <section class="ip-cta-strip">
      <div class="container ip-cta-inner">
        <div>
          <h2 class="ip-cta-h2">Ready for a Fresh Interior?</h2>
          <p>Call Boomer or fill out the quote form. Free estimates, fast scheduling.</p>
        </div>
        <div class="ip-cta-btns">
          <a href="/contact" class="btn-amber">Get a Free Quote →</a>
          <a href="tel:+12512374545" class="ip-phone">(251) 237-4545</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber);
  }

  .btn-amber {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.9rem 2rem; background: var(--amber); color: var(--ink);
    font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800;
    text-decoration: none; border-radius: var(--radius-md);
    box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s;
  }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  .ip-section { padding: 5.5rem 0 6rem; }
  .ip-cream { background: var(--cream); }
  .ip-dark { background: var(--ink-soft); }

  /* Split layout */
  .ip-split {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 5rem; align-items: center;
  }

  .ip-split-content { display: flex; flex-direction: column; gap: 1.25rem; }

  .ip-h2 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900;
    letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0;
  }

  .ip-h2 em {
    font-family: var(--font-display); font-style: italic; font-weight: 400;
    color: var(--amber-deep); letter-spacing: -0.02em;
  }

  .ip-h2-white { color: #fff; }
  .ip-h2-white em { color: var(--amber); }

  .ip-split-content > p {
    font-family: var(--font-sans); font-size: 1.0625rem;
    color: var(--text-muted); line-height: 1.7; margin: 0;
  }

  .ip-feature-list {
    list-style: none; padding: 0; margin: 0.5rem 0;
    display: flex; flex-direction: column; gap: 1.25rem;
  }

  .ip-feature-list li {
    display: flex; gap: 1rem; align-items: flex-start;
  }

  .ip-feat-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    color: var(--amber); margin-top: 0.1rem;
  }

  .ip-feature-list strong {
    font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800;
    color: var(--ink); display: block; margin-bottom: 0.2rem;
  }

  .ip-feature-list p {
    font-family: var(--font-sans); font-size: 0.875rem;
    color: var(--text-muted); line-height: 1.6; margin: 0;
  }

  .ip-split-img {
    position: relative; border-radius: var(--radius-xl); overflow: hidden;
    aspect-ratio: 4/5;
  }

  .ip-split-img img {
    width: 100%; height: 100%; object-fit: cover;
    filter: brightness(1.05) saturate(1.15);
  }

  .ip-img-badge {
    position: absolute; bottom: 1.5rem; right: 1.5rem;
    background: var(--amber); border-radius: var(--radius-md);
    padding: 1rem 1.25rem; text-align: center;
  }

  .ip-img-badge strong {
    display: block; font-family: var(--font-sans);
    font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; color: var(--ink);
  }

  .ip-img-badge span {
    font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em; color: rgba(17,24,39,0.65);
  }

  /* Standards grid */
  .ip-section-top { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }

  .ip-standards-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-xl); overflow: hidden;
  }

  .ip-standard {
    padding: 2rem 1.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    border-right: 1px solid rgba(255,255,255,0.05);
    display: flex; flex-direction: column; gap: 0.75rem;
    position: relative;
  }

  .ip-std-num {
    font-family: var(--font-sans); font-size: 0.625rem; font-weight: 900;
    letter-spacing: 0.1em; color: var(--amber); opacity: 0.7;
  }

  .ip-standard h4 {
    font-family: var(--font-sans); font-size: 1rem; font-weight: 800;
    color: #fff; margin: 0; letter-spacing: -0.02em;
  }

  .ip-standard p {
    font-family: var(--font-sans); font-size: 0.875rem;
    color: rgba(255,255,255,0.45); line-height: 1.65; margin: 0;
  }

  /* CTA strip */
  .ip-cta-strip { background: var(--ink); padding: 4.5rem 0; }

  .ip-cta-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 3rem;
  }

  .ip-cta-h2 {
    font-family: var(--font-sans); font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 900; letter-spacing: -0.04em; color: #fff; margin: 0 0 0.5rem;
  }

  .ip-cta-strip p {
    font-family: var(--font-sans); font-size: 1rem;
    color: rgba(255,255,255,0.45); margin: 0;
  }

  .ip-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }

  .ip-phone {
    font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900;
    letter-spacing: -0.02em; color: rgba(255,255,255,0.35);
    text-decoration: none; white-space: nowrap;
  }
  .ip-phone:hover { color: var(--amber); }

  @media (max-width: 900px) {
    .ip-split { grid-template-columns: 1fr; gap: 3rem; }
    .ip-split-img { aspect-ratio: 16/9; max-height: 400px; }
    .ip-standards-grid { grid-template-columns: repeat(2, 1fr); }
    .ip-cta-inner { flex-direction: column; text-align: center; }
    .ip-cta-btns { flex-direction: column; }
  }

  @media (max-width: 640px) {
    .ip-standards-grid { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
