---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import Testimonials from '../components/Testimonials.astro';

const title = "Exterior Painting Services | Browns Painting South Alabama";
const description = "Weather-resistant exterior painting built for Alabama's climate. Pressure washing, prep, and premium paint. Serving South Alabama since 1998.";
---

<BaseLayout title={title} description={description}>
  <main>

    <InnerPageHero
      title="Exterior Painting Services"
      subtitle="Weather-resistant coatings built for Alabama's heat and humidity. Pressure washing, prep, and premium paint."
      eyebrow="Exterior Painting"
      bg="/images/projects/projects-optimized/exterior-paint-1-optimized.jpg"
    />

    <!-- ── WHAT WE DO ── -->
    <section class="ep-section ep-cream">
      <div class="container">
        <div class="ep-split">
          <div class="ep-split-img">
            <img src="/images/projects/projects-optimized/brewton-exterior-1-optimized.jpg" alt="Exterior painting project" loading="lazy" />
            <div class="ep-img-badge">
              <strong>500+</strong>
              <span>Exteriors Painted</span>
            </div>
          </div>
          <div class="ep-split-content">
            <span class="eyebrow">What We Do</span>
            <h2 class="ep-h2">Built to Last <em>Alabama Summers.</em></h2>
            <p>South Alabama's heat, humidity, and storms are brutal on exterior paint. We use the right prep, primer, and premium paint to ensure your home stays protected and beautiful for years.</p>
            <ul class="ep-feature-list">
              <li>
                <div class="ep-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg></div>
                <div><strong>Siding &amp; Trim</strong><p>Full exterior painting including siding, fascia boards, soffits, shutters, and trim for a cohesive look.</p></div>
              </li>
              <li>
                <div class="ep-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div><strong>Pressure Washing</strong><p>Full surface cleaning before any paint hits the wall. Proper pressure washing extends paint life dramatically.</p></div>
              </li>
              <li>
                <div class="ep-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="1.75"/></svg></div>
                <div><strong>Deck &amp; Fence Staining</strong><p>UV-resistant stains and sealers that protect wood against Alabama's moisture and sun damage.</p></div>
              </li>
              <li>
                <div class="ep-feat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div><strong>Storm Damage Repair</strong><p>Fast response for storm-damaged exteriors. We work with insurance claims and get your home protected quickly.</p></div>
              </li>
            </ul>
            <a href="/contact" class="btn-amber">Get a Free Exterior Quote →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── PROCESS ── -->
    <section class="ep-section ep-dark">
      <div class="container">
        <div class="ep-section-top">
          <span class="eyebrow">Our Process</span>
          <h2 class="ep-h2 ep-h2-white">How We Prep. <em>Why It Matters.</em></h2>
          <p class="ep-intro-white">85% of paint failures are caused by improper surface preparation. We don't cut corners.</p>
        </div>
        <div class="ep-steps">
          <div class="ep-step">
            <div class="ep-step-num">01</div>
            <h4>Pressure Wash</h4>
            <p>Full exterior cleaning to remove dirt, mildew, chalking, and loose paint. We let surfaces dry completely before proceeding.</p>
          </div>
          <div class="ep-step">
            <div class="ep-step-num">02</div>
            <h4>Scrape &amp; Sand</h4>
            <p>Manual scraping of all peeling or failing paint, followed by sanding to create a smooth, paintable surface.</p>
          </div>
          <div class="ep-step">
            <div class="ep-step-num">03</div>
            <h4>Caulk &amp; Fill</h4>
            <p>All cracks, gaps, and holes sealed with high-quality exterior caulk to prevent moisture intrusion.</p>
          </div>
          <div class="ep-step">
            <div class="ep-step-num">04</div>
            <h4>Prime &amp; Paint</h4>
            <p>Spot-prime bare wood and bare surfaces, then apply two finish coats of premium exterior paint.</p>
          </div>
        </div>
      </div>
    </section>

    <Testimonials />

    <!-- ── CTA ── -->
    <section class="ep-cta-strip">
      <div class="container ep-cta-inner">
        <div>
          <h2 class="ep-cta-h2">Protect Your Home.<br/><em>Start With a Free Estimate.</em></h2>
          <p>Fast scheduling, transparent pricing, and results you'll be proud of.</p>
        </div>
        <div class="ep-cta-btns">
          <a href="/contact" class="btn-amber">Get a Free Quote →</a>
          <a href="tel:+12512374545" class="ep-phone">(251) 237-4545</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .eyebrow { display: inline-block; font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); }
  .btn-amber { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--amber); color: var(--ink); font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-amber); transition: background 0.2s, transform 0.2s; }
  .btn-amber:hover { background: var(--amber-deep); transform: translateY(-2px); }

  .ep-section { padding: 5.5rem 0 6rem; }
  .ep-cream { background: var(--cream); }
  .ep-dark { background: var(--ink-soft); }

  .ep-split { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .ep-split-content { display: flex; flex-direction: column; gap: 1.25rem; }

  .ep-h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); margin: 0; }
  .ep-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; color: var(--amber-deep); letter-spacing: -0.02em; }
  .ep-h2-white { color: #fff; }
  .ep-h2-white em { color: var(--amber); }

  .ep-split-content > p { font-family: var(--font-sans); font-size: 1.0625rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  .ep-feature-list { list-style: none; padding: 0; margin: 0.5rem 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .ep-feature-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .ep-feat-icon { width: 40px; height: 40px; flex-shrink: 0; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--amber); margin-top: 0.1rem; }
  .ep-feature-list strong { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 800; color: var(--ink); display: block; margin-bottom: 0.2rem; }
  .ep-feature-list p { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .ep-split-img { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4/5; }
  .ep-split-img img { width: 100%; height: 100%; object-fit: cover; filter: brightness(1.05) saturate(1.15); }
  .ep-img-badge { position: absolute; bottom: 1.5rem; left: 1.5rem; background: var(--amber); border-radius: var(--radius-md); padding: 1rem 1.25rem; text-align: center; }
  .ep-img-badge strong { display: block; font-family: var(--font-sans); font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; color: var(--ink); }
  .ep-img-badge span { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(17,24,39,0.65); }

  .ep-section-top { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .ep-intro-white { font-family: var(--font-sans); font-size: 1.0625rem; color: rgba(255,255,255,0.45); max-width: 560px; line-height: 1.7; margin: 0; }

  .ep-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: rgba(255,255,255,0.06); border: 1.5px solid rgba(255,255,255,0.06); border-radius: var(--radius-xl); overflow: hidden; }
  .ep-step { background: var(--ink-soft); padding: 2.25rem 1.75rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .ep-step-num { font-family: var(--font-sans); font-size: 0.625rem; font-weight: 900; letter-spacing: 0.12em; color: var(--amber); }
  .ep-step h4 { font-family: var(--font-sans); font-size: 1.0625rem; font-weight: 800; color: #fff; margin: 0; letter-spacing: -0.02em; }
  .ep-step p { font-family: var(--font-sans); font-size: 0.875rem; color: rgba(255,255,255,0.45); line-height: 1.65; margin: 0; }

  .ep-cta-strip { background: var(--amber); padding: 4.5rem 0; }
  .ep-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .ep-cta-h2 { font-family: var(--font-sans); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.15; color: var(--ink); margin: 0 0 0.5rem; }
  .ep-cta-h2 em { font-family: var(--font-display); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }
  .ep-cta-strip p { font-family: var(--font-sans); font-size: 1rem; color: rgba(17,24,39,0.65); margin: 0; }
  .ep-cta-btns { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .ep-phone { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 900; letter-spacing: -0.02em; color: rgba(17,24,39,0.5); text-decoration: none; white-space: nowrap; }
  .ep-phone:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .ep-split { grid-template-columns: 1fr; gap: 3rem; }
    .ep-split-img { aspect-ratio: 16/9; max-height: 380px; order: -1; }
    .ep-steps { grid-template-columns: repeat(2, 1fr); }
    .ep-cta-inner { flex-direction: column; text-align: center; }
    .ep-cta-btns { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .ep-steps { grid-template-columns: 1fr; }
    .container { padding: 0 1.25rem; }
  }
</style>
