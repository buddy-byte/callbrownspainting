---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Exterior Painting Services | Professional Painters South Alabama";
const description = "Protect and beautify your home with professional exterior painting. Serving Mobile, Daphne, Fairhope, Gulf Shores, and surrounding South Alabama areas.";
---

<BaseLayout title={title} description={description}>
  <main>
    <!-- Hero Section (Keep Existing) -->
    <section class="hero">
      <div class="hero-background">
        <div class="hero-slide active" style="background-image: url('/images/hero/hero-1-optimized.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/projects/projects-optimized/interior-painting-2-optimized.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero-3-optimized.jpg'); background-position: center top;"></div>
      </div>
      
      <div class="hero-overlay"></div>
      
      <div class="hero-trust-badges">
        <div class="trust-badge">
          <span class="trust-stars">★★★★★</span>
          <span class="trust-text">5-Star Reviews</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">🏆</span>
          <span class="trust-text">25+ Years</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">📋</span>
          <span class="trust-text">Licensed & Insured</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">✅</span>
          <span class="trust-text">100% Guaranteed</span>
        </div>
      </div>

      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <img src="/images/logo/browns-painting-logo-hat.png" alt="Browns Painting" class="hero-logo-image" />
            <h1>Exterior Painting Services</h1>
            <p class="hero-subtitle">Protect and beautify your home with professional exterior painting</p>
            <div class="phone-number">
              <span class="phone-label">Call Us Today at</span>
              <a href="tel:+12512374545" class="phone-link">(251) 237-4545</a>
            </div>
            <div class="hero-cta">
              <a href="/contact" class="btn btn-primary">
                <span class="btn-icon">📋</span>
                Get A Free Quote
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="hero-dots">
        <span class="dot active" data-slide="0"></span>
        <span class="dot" data-slide="1"></span>
        <span class="dot" data-slide="2"></span>
      </div>
    </section>

    <!-- Services Section - Inline Styles -->
    <section style="padding: 5rem 0; background: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
        <div style="text-align: center; margin-bottom: 4rem;">
          <span style="display: inline-block; padding: 0.5rem 1.5rem; background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.1)); color: #3b82f6; font-weight: 700; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 1px; border-radius: 50px; margin-bottom: 1rem; border: 1px solid rgba(59, 130, 246, 0.2);">What We Offer</span>
          <h2 style="font-size: 3rem; font-weight: 900; color: #1f2937; margin-bottom: 1rem;">Our Services</h2>
          <p style="font-size: 1.25rem; color: #6b7280;">Professional painting services backed by 25+ years of experience</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
          
          <div style="background: white; padding: 2.5rem; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: 2px solid #f3f4f6;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem;">🏡</div>
            <h3 style="font-size: 1.75rem; font-weight: 800; color: #1f2937; margin-bottom: 1rem;">House Painting</h3>
            <p style="color: #6b7280; line-height: 1.7; margin-bottom: 1.5rem;">Complete exterior house painting with weather-resistant coatings</p>
            <ul style="list-style: none; padding: 0; margin: 1.5rem 0;">
              <li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Siding & trim painting</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Deck & fence staining</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Front door painting</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Garage door refinishing</li>
            </ul>
          </div>
          <div style="background: white; padding: 2.5rem; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: 2px solid #f3f4f6;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem;">🛡️</div>
            <h3 style="font-size: 1.75rem; font-weight: 800; color: #1f2937; margin-bottom: 1rem;">Surface Prep</h3>
            <p style="color: #6b7280; line-height: 1.7; margin-bottom: 1.5rem;">Thorough preparation ensures long-lasting results</p>
            <ul style="list-style: none; padding: 0; margin: 1.5rem 0;">
              <li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Pressure washing</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Wood rot repair</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Caulking & sealing</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Prime & paint</li>
            </ul>
          </div>
          <div style="background: white; padding: 2.5rem; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: 2px solid #f3f4f6;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem;">🎨</div>
            <h3 style="font-size: 1.75rem; font-weight: 800; color: #1f2937; margin-bottom: 1rem;">Weather Protection</h3>
            <p style="color: #6b7280; line-height: 1.7; margin-bottom: 1.5rem;">Coatings designed for Alabama humid climate</p>
            <ul style="list-style: none; padding: 0; margin: 1.5rem 0;">
              <li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Moisture resistance</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ UV protection</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Mildew prevention</li><li style="color: #10b981; margin-bottom: 0.75rem; font-weight: 500;">✓ Multi-year durability</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section - Inline Styles -->
    <section style="padding: 5rem 0; background: #f8fafc;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
        <div style="text-align: center; margin-bottom: 4rem;">
          <h2 style="font-size: 3rem; font-weight: 900; color: #1f2937; margin-bottom: 1rem;">Frequently Asked Questions</h2>
        </div>

        <div style="display: grid; gap: 1.5rem;">
          
          <div style="background: #f8fafc; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); border-left: 4px solid #3b82f6;">
            <h3 style="color: #1e40af; margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700;">How long does exterior painting take?</h3>
            <p style="line-height: 1.7; color: #4b5563; margin: 0;">Most exterior painting projects take 3-7 days depending on the size of your home, weather conditions, and amount of prep work needed. We always provide a detailed timeline with your estimate.</p>
          </div>
          <div style="background: #f8fafc; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); border-left: 4px solid #3b82f6;">
            <h3 style="color: #1e40af; margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700;">What is the best time of year to paint exteriors in Alabama?</h3>
            <p style="line-height: 1.7; color: #4b5563; margin: 0;">Spring and fall are ideal for exterior painting in Alabama. We need temperatures between 50-90°F and dry weather for at least 24 hours after painting. We monitor weather closely and schedule accordingly.</p>
          </div>
          <div style="background: #f8fafc; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); border-left: 4px solid #3b82f6;">
            <h3 style="color: #1e40af; margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700;">How long will exterior paint last?</h3>
            <p style="line-height: 1.7; color: #4b5563; margin: 0;">With proper surface preparation and quality paint, exterior painting typically lasts 7-10 years in Alabama climate. Factors like sun exposure, moisture, and surface type affect longevity.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to Get Started?</h2>
        <p>Contact Browns Painting today for a free estimate on your project.</p>
        <a href="/contact" class="btn btn-primary">
          <span class="btn-icon">📞</span>
          Get Free Estimate
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section - Keep Existing Styles */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: white;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.4) 100%);
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    text-align: center;
  }

  .hero-text {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero-logo-image {
    height: 300px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    margin-bottom: 0;
  }

  .hero h1 {
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 800;
    margin: 0;
    margin-top: -4rem;
    margin-bottom: 1rem;
    line-height: 1.1;
    color: white;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .phone-number {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    justify-content: center;
    margin: 0;
  }

  .phone-label {
    font-weight: 500;
  }

  .phone-link {
    color: #fbbf24;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .phone-link:hover {
    color: #f59e0b;
    text-decoration: underline;
  }

  .hero-cta {
    margin-top: 2rem;
  }

  .hero-trust-badges {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1.5rem;
    z-index: 4;
    flex-wrap: wrap;
    justify-content: center;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.94rem 1.56rem;
    background: transparent;
    color: white;
    font-size: 1.125rem;
    font-weight: 600;
    transition: all 0.3s ease;
    white-space: nowrap;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }

  .trust-badge:hover {
    transform: translateY(-2px);
    text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.9);
  }

  .trust-badge .trust-icon {
    font-size: 1.56rem;
    color: #fbbf24;
  }

  .trust-badge .trust-stars {
    font-size: 1.56rem;
    color: #fbbf24;
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }

  .trust-badge .trust-text {
    font-size: 1.06rem;
    font-weight: 600;
  }

  .hero-dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 3;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: #fbbf24;
    transform: scale(1.2);
  }

  .dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s ease;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: #1f2937;
    box-shadow: 
      0 8px 25px rgba(251, 191, 36, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
  }

  .btn-primary:hover::before {
    left: 100%;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    transform: translateY(-3px);
    box-shadow: 
      0 12px 35px rgba(251, 191, 36, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .btn-icon {
    font-size: 1.25rem;
  }

  .cta-section {
    text-align: center;
    padding: 5rem 2rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .cta-section h2 {
    margin-bottom: 1rem;
    font-size: 2.5rem;
    font-weight: 800;
  }

  .cta-section p {
    margin-bottom: 2rem;
    font-size: 1.125rem;
    opacity: 0.95;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .hero {
      height: 80vh;
      min-height: 500px;
    }
    
    .hero-logo-image {
      height: 180px;
    }
    
    .hero h1 {
      font-size: 2rem;
      margin-top: -2rem;
    }
    
    .hero-trust-badges {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      top: 0.75rem;
    }
    
    .trust-badge {
      font-size: 0.75rem;
      padding: 0.5rem 0.75rem;
    }
  }
</style>

<script is:inline>
(function() {
  'use strict';
  
  function initCarousel() {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.dot');
    
    if (!slides || slides.length === 0) return;
    
    let currentSlide = 0;
    let slideInterval = null;

    function showSlide(index) {
      slides.forEach(function(slide) { slide.classList.remove('active'); });
      dots.forEach(function(dot) { dot.classList.remove('active'); });
      
      if (slides[index]) slides[index].classList.add('active');
      if (dots[index]) dots[index].classList.add('active');
      
      currentSlide = index;
    }

    function nextSlide() {
      const next = (currentSlide + 1) % slides.length;
      showSlide(next);
    }

    function startSlider() {
      if (slideInterval) clearInterval(slideInterval);
      slideInterval = setInterval(nextSlide, 5000);
    }

    dots.forEach(function(dot, index) {
      dot.addEventListener('click', function() {
        showSlide(index);
        startSlider();
      });
    });

    startSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
})();
</script>
