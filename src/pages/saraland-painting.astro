---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Saraland Painting', url: '/saraland-painting' }
];
---

<BaseLayout
  title="Painting Services in Saraland, AL | Browns Painting LLC"
  description="Professional painting services in Saraland, Alabama. Interior, exterior, and commercial painting by Browns Painting — Mobile County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Saraland AL, house painter Saraland Alabama, Mobile County painting services, interior painting Saraland, exterior painting Saraland"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Saraland AL"
    serviceDescription="Expert painting services in Saraland, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/saraland-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Saraland"
      county="Mobile County"
      slug="saraland"
      nearbyLinks={[
  { name: 'Mobile', url: '/mobile-painting' },
  { name: 'Theodore', url: '/theodore-painting' },
  { name: 'Creola', url: '/creola-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
