---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Lenox Painting', url: '/lenox-painting' }
];
---

<BaseLayout
  title="Painting Services in Lenox, AL | Browns Painting LLC"
  description="Professional painting services in Lenox, Alabama. Interior, exterior, and commercial painting by Browns Painting — Conecuh County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Lenox AL, house painter Lenox Alabama, Conecuh County painting services, interior painting Lenox, exterior painting Lenox"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Lenox AL"
    serviceDescription="Expert painting services in Lenox, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/lenox-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Lenox"
      county="Conecuh County"
      slug="lenox"
      nearbyLinks={[
  { name: 'Evergreen', url: '/evergreen-painting' },
  { name: 'Castleberry', url: '/castleberry-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
