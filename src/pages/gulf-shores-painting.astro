---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Gulf Shores Painting', url: '/gulf-shores-painting' }
];
---

<BaseLayout
  title="Painting Services in Gulf Shores, AL | Browns Painting LLC"
  description="Professional painting services in Gulf Shores, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Gulf Shores AL, house painter Gulf Shores Alabama, Baldwin County painting services, interior painting Gulf Shores, exterior painting Gulf Shores"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Gulf Shores AL"
    serviceDescription="Expert painting services in Gulf Shores, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/gulf-shores-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Gulf Shores"
      county="Baldwin County"
      slug="gulf-shores"
      nearbyLinks={[
  { name: 'Orange Beach', url: '/orange-beach-painting' },
  { name: 'Foley', url: '/foley-painting' },
  { name: 'Fairhope', url: '/fairhope-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
