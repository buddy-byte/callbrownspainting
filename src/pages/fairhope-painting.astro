---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Fairhope Painting', url: '/fairhope-painting' }
];
---

<BaseLayout
  title="Painting Services in Fairhope, AL | Browns Painting LLC"
  description="Professional painting services in Fairhope, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Fairhope AL, house painter Fairhope Alabama, Baldwin County painting services, interior painting Fairhope, exterior painting Fairhope"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Fairhope AL"
    serviceDescription="Expert painting services in Fairhope, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/fairhope-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Fairhope"
      county="Baldwin County"
      slug="fairhope"
      nearbyLinks={[
  { name: 'Daphne', url: '/daphne-painting' },
  { name: 'Mobile', url: '/mobile-painting' },
  { name: 'Foley', url: '/foley-painting' },
  { name: 'Daphne', url: '/daphne-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
