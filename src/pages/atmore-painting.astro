---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Atmore Painting', url: '/atmore-painting' }
];
---

<BaseLayout
  title="Painting Services in Atmore, AL | Browns Painting LLC"
  description="Professional painting services in Atmore, Alabama. Interior, exterior, and commercial painting by Browns Painting — Escambia County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Atmore AL, house painter Atmore Alabama, Escambia County painting services, interior painting Atmore, exterior painting Atmore"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Atmore AL"
    serviceDescription="Expert painting services in Atmore, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/atmore-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Atmore"
      county="Escambia County"
      slug="atmore"
      nearbyLinks={[
  { name: 'Brewton', url: '/brewton-painting' },
  { name: 'Flomaton', url: '/flomaton-painting' },
  { name: 'Evergreen', url: '/evergreen-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
