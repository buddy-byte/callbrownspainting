---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "House Painter in Loxley AL | Professional Painting Services Baldwin County";
const description = "Expert house painters in Loxley, Alabama serving Baldwin County. Licensed, insured, locally owned.";
const keywords = "house painter Loxley AL, painters Loxley Alabama, Baldwin County painting";

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Loxley Painting', url: '/loxley-painting' }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <!-- Service Schema -->
    <ServiceSchema
      serviceName="Professional House Painting Services in Loxley AL"
      serviceDescription="Expert house painters in Loxley, Alabama serving Baldwin County. Licensed, insured, locally owned."
      serviceUrl="https://callbrownspainting.com/loxley-painting"
      serviceType="House Painting"
      priceRange="$$"
      serviceImage="https://callbrownspainting.com/assets/loxley-painting-service.jpg"
    />

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background">
        <div class="hero-slide active" style="background-image: url('/images/hero/hero-1-optimized.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/projects/projects-optimized/interior-painting-2-optimized.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero/hero-3-optimized.jpg'); background-position: center top;"></div>
      </div>
      
      <div class="hero-overlay"></div>
      
      <div class="hero-trust-badges">
        <div class="trust-badge">
          <span class="trust-stars">★★★★★</span>
          <span class="trust-text">5-Star Reviews</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">🏆</span>
          <span class="trust-text">25+ Years</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">📋</span>
          <span class="trust-text">Licensed & Insured</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">✅</span>
          <span class="trust-text">100% Guaranteed</span>
        </div>
      </div>

      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <img src="/images/logo/browns-painting-logo-hat.png" alt="Browns Painting" class="hero-logo-image" />
            <h1>Professional Painting Services in Loxley, AL</h1>
            <div class="phone-number">
              <span class="phone-label">Call Us Today at</span>
              <a href="tel:+12512374545" class="phone-link">(251) 237-4545</a>
            </div>
            <div class="hero-cta">
              <a href="/contact" class="btn btn-primary">
                <span class="btn-icon">📋</span>
                Get A Free Quote
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="hero-dots">
        <span class="dot active" data-slide="0"></span>
        <span class="dot" data-slide="1"></span>
        <span class="dot" data-slide="2"></span>
      </div>
    </section>

    <!-- Stats Section - BEAUTIFUL BADGES -->
    <section class="stats-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-badge">
            <div class="badge-icon">🏆</div>
            <div class="badge-content">
              <div class="badge-number">25+</div>
              <div class="badge-label">Years Experience</div>
            </div>
          </div>
          <div class="stat-badge">
            <div class="badge-icon">🛡️</div>
            <div class="badge-content">
              <div class="badge-number">100%</div>
              <div class="badge-label">Licensed & Insured</div>
            </div>
          </div>
          <div class="stat-badge">
            <div class="badge-icon">⚡</div>
            <div class="badge-content">
              <div class="badge-number">3-7 Days</div>
              <div class="badge-label">Most Projects</div>
            </div>
          </div>
          <div class="stat-badge">
            <div class="badge-icon">✅</div>
            <div class="badge-content">
              <div class="badge-number">100%</div>
              <div class="badge-label">Satisfaction Guarantee</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us Section - PHOTO LEFT / CARDS RIGHT -->
    <section class="section-white">
      <div class="container-wide">
        <div class="benefits-split">
          <div class="benefits-photo-side">
            <h2>Why Loxley Homeowners Choose Browns Painting</h2>
            <img src="/images/boomer-photos/boomer-3-optimized.jpg" alt="Boomer Brown and Browns Painting team" class="benefits-large-photo" />
          </div>
          
          <div class="benefits-cards-side">
            <div class="benefit-card">
              <div class="benefit-icon">🎨</div>
              <h3>25+ Years of Experience</h3>
              <p>Boomer Brown has been painting homes in South Alabama since the 1990s. You're hiring a master craftsman.</p>
            </div>
            
            <div class="benefit-card">
              <div class="benefit-icon">⚡</div>
              <h3>Fast & Efficient</h3>
              <p>Most Loxley homes completed in 3-7 days. We respect your time.</p>
            </div>
            
            <div class="benefit-card">
              <div class="benefit-icon">💎</div>
              <h3>Premium Materials</h3>
              <p>Sherwin-Williams and Benjamin Moore only - perfect for Alabama's humid climate.</p>
            </div>
            
            <div class="benefit-card">
              <div class="benefit-icon">🛡️</div>
              <h3>Licensed & Insured</h3>
              <p>Fully licensed and insured in Baldwin County. Your property is protected.</p>
            </div>
            
            <div class="benefit-card">
              <div class="benefit-icon">✅</div>
              <h3>100% Satisfaction Guarantee</h3>
              <p>Not happy? We fix it. That's our promise to every Loxley customer.</p>
            </div>
            
            <div class="benefit-card">
              <div class="benefit-icon">📞</div>
              <h3>Direct Access to Owner</h3>
              <p>Call (251) 237-4545 and talk to Boomer directly. No middlemen.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--Services Section - TOP CENTERED -->
    <section class="section-blue">
      <div class="container-wide">
        <div class="section-header" style="text-align: center;">
          <h2>Complete Painting Services in Loxley</h2>
          <p>From transforming interiors to protecting exteriors, we deliver exceptional craftsmanship on every project.</p>
        </div>
        
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">🏠</div>
            <h3>Interior Painting</h3>
            <p>Transform your Loxley home's interior with expert color consultation and flawless application.</p>
            <ul>
              <li>Living rooms & bedrooms</li>
              <li>Kitchen & bathrooms</li>
              <li>Cabinet refinishing</li>
              <li>Drywall repair</li>
              <li>Trim & molding</li>
            </ul>
            <a href="/interior-painting" class="service-link">Learn More →</a>
          </div>
          
          <div class="service-card">
            <div class="service-icon">🎨</div>
            <h3>Exterior Painting</h3>
            <p>Protect and beautify your Loxley home with weather-resistant coatings designed for coastal Alabama.</p>
            <ul>
              <li>House siding & trim</li>
              <li>Deck & porch painting</li>
              <li>Fence staining</li>
              <li>Pressure washing</li>
              <li>Wood rot repair</li>
            </ul>
            <a href="/exterior-painting" class="service-link">Learn More →</a>
          </div>
          
          <div class="service-card">
            <div class="service-icon">🏢</div>
            <h3>Commercial Painting</h3>
            <p>Professional commercial services for Loxley businesses with flexible scheduling and minimal disruption.</p>
            <ul>
              <li>Office buildings</li>
              <li>Retail spaces</li>
              <li>Restaurants</li>
              <li>After-hours available</li>
              <li>Licensed & bonded</li>
            </ul>
            <a href="/commercial-painting" class="service-link">Learn More →</a>
          </div>
          
          <div class="service-card">
            <div class="service-icon">🚨</div>
            <h3>Emergency Repairs</h3>
            <p>Fast response for urgent painting needs in Loxley - storm damage, water damage, and emergency touch-ups.</p>
            <ul>
              <li>24/7 availability</li>
              <li>Storm damage repair</li>
              <li>Water damage fix</li>
              <li>Insurance claims help</li>
              <li>Same-day response</li>
            </ul>
            <a href="/emergency-painting" class="service-link">Learn More →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section - CONTENT LEFT / PHOTO RIGHT -->
    <section class="section-amber">
      <div class="container-wide">
        <div class="testimonials-split-layout">
          <div class="testimonials-content-left">
            <h2>What Loxley Homeowners Say</h2>
            
            <div class="testimonials-grid">
              <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p class="testimonial-text">"We've used Browns Painting twice now - both times exceeded expectations. Fair pricing, quality work!"</p>
                <div class="testimonial-author">
                  <strong>Robert & Linda T.</strong>
                  <span>Belforest</span>
                </div>
          </div>
          
              <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p class="testimonial-text">"After getting 3 quotes, we chose Browns Painting and couldn't be happier. Professional, punctual, and quality work!"</p>
                <div class="testimonial-author">
                  <strong>Michael K.</strong>
                  <span>Montrose, Loxley</span>
                </div>
              </div>
              
              <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p class="testimonial-text">"Best contractor experience in Baldwin County! Transformed our dated home. The prep work was thorough and finish quality exceptional."</p>
                <div class="testimonial-author">
                  <strong>Patricia S.</strong>
                  <span>Village Point, Loxley</span>
                </div>
              </div>
              
              <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p class="testimonial-text">"Boomer painted our Lake Forest home. Attention to detail was incredible. Done in 4 days!"</p>
                <div class="testimonial-author">
                  <strong>Jennifer M.</strong>
                  <span>Lake Forest, Loxley</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="testimonials-photo-right">
            <img src="/images/projects/projects-optimized/brewton-exterior-1-optimized.jpg" alt="Beautiful home painted by Browns Painting" class="testimonial-large-photo" />
          </div>
        </div>
      </div>
    </section>

    <!-- Service Areas Section - BADGE CLOUD LAYOUT -->
    <section class="section-white">
      <div class="container">
        <div class="areas-header-center">
          <span class="areas-tagline">SERVING ALL OF DAPHNE</span>
          <h2 class="areas-title">Your Neighborhood Painting Experts</h2>
          <p class="areas-subtitle">Professional painting services throughout Baldwin County & the Eastern Shore</p>
          </div>
        
        <div class="areas-badge-cloud">
          <span class="area-badge primary">📍 Downtown Loxley</span>
          <span class="area-badge primary">📍 Malbis</span>
          <span class="area-badge primary">📍 North Loxley</span>
          <span class="area-badge">South Loxley</span>
          <span class="area-badge secondary">Spanish Fort (10 min)</span>
          <span class="area-badge secondary">Daphne (15 min)</span>
          <span class="area-badge secondary">Fairhope (15 min)</span>
        </div>
        
        <div class="areas-cta-strip">
          <p><strong>Don't see your area?</strong> We service all of Baldwin County</p>
          <a href="tel:2512374545" class="btn-text-link">Call (251) 237-4545 →</a>
          </div>
          </div>
    </section>

    <!-- FAQ Section - TOP CENTERED -->
    <section class="section-dark-navy">
      <div class="container-wide">
        <div class="section-header">
          <h2>Everything You Need to Know</h2>
          <p>Common questions about painting services in Loxley, Alabama</p>
        </div>
        
        <div class="faq-grid">
          <div class="faq-item">
            <h3>💰 How much does house painting cost in Loxley?</h3>
            <p>Painting costs in Loxley typically range from <strong>$2.50-$4.50 per square foot</strong> for interior work and <strong>$1.80-$3.50 per square foot</strong> for exterior painting. The final price depends on your home size, surface prep needed, paint quality, and project complexity. We offer <strong>free, detailed estimates</strong> for all Loxley properties.</p>
          </div>
          
          <div class="faq-item">
            <h3>⏱️ How long does it take to paint a house in Loxley?</h3>
            <p>Most residential projects take <strong>3-7 days</strong> to complete. Interior painting typically takes 2-4 days for an average home, while exterior painting requires 3-5 days depending on weather. We provide a detailed timeline with your free estimate.</p>
          </div>
          
          <div class="faq-item">
            <h3>🏠 Do I need to be home during the painting?</h3>
            <p>Not necessarily! Many Loxley homeowners prefer to be away to avoid disruption. We're fully insured and trustworthy, and can work independently once access is arranged. Your choice entirely.</p>
          </div>
          
          <div class="faq-item">
            <h3>🎨 What brands of paint do you use?</h3>
            <p>We exclusively use <strong>Sherwin-Williams and Benjamin Moore</strong> - premium brands perfect for Alabama's humid coastal climate. These professional-grade paints offer superior coverage, durability, and color retention.</p>
          </div>
          
          <div class="faq-item">
            <h3>📋 Are you licensed and insured in Baldwin County?</h3>
            <p>Yes! Browns Painting is <strong>fully licensed and insured</strong> to work throughout Baldwin County. We carry comprehensive liability insurance and workers' comp, protecting both our team and your property.</p>
          </div>
          
          <div class="faq-item">
            <h3>📞 How do I get started?</h3>
            <p>Simple! Call <strong>(251) 237-4545</strong> to speak directly with Boomer, or <a href="/contact" style="color: #fbbf24; text-decoration: underline;">request a free estimate online</a>. We'll schedule a convenient time to view your project and provide a detailed quote.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section - EPIC FINALE -->
    <section class="cta-final-epic">
      <div class="cta-epic-bg"></div>
      <div class="container">
        <div class="cta-epic-content">
          <span class="cta-epic-tagline">MAKE THE CHOICE</span>
          <h2 class="cta-epic-title">Ready to Transform Your Loxley Home?</h2>
          <p class="cta-epic-subtitle">Join 500+ satisfied homeowners who chose Browns Painting for quality, reliability, and exceptional craftsmanship</p>
          
          <div class="cta-epic-buttons">
            <a href="tel:+12512374545" class="btn-epic-primary">
              <span class="btn-epic-icon">📞</span>
              <span class="btn-epic-text">
                <strong>Call Now</strong>
                <small>(251) 237-4545</small>
              </span>
            </a>
            <a href="/contact" class="btn-epic-secondary">
              <span class="btn-epic-icon">📋</span>
              <span class="btn-epic-text">
                <strong>Get Free Quote</strong>
                <small>Response in 24hrs</small>
              </span>
            </a>
          </div>
          
          <div class="cta-epic-features">
            <div class="epic-feature">
              <span class="epic-feature-icon">✓</span>
              <span>Free Estimates</span>
            </div>
            <div class="epic-feature">
              <span class="epic-feature-icon">✓</span>
              <span>Licensed & Insured</span>
            </div>
            <div class="epic-feature">
              <span class="epic-feature-icon">✓</span>
              <span>100% Guarantee</span>
            </div>
            <div class="epic-feature">
              <span class="epic-feature-icon">✓</span>
              <span>25+ Years Experience</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container-wide {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container-full {
    max-width: 100%;
    padding: 0 2rem;
  }

  .container-full-width {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Section Backgrounds - BOLD Alternating Pattern */
  .section-white {
    background: #ffffff;
    padding: 8rem 0;
  }

  .section-blue {
    background: linear-gradient(135deg, #0a2540 0%, #3b82f6 50%, #0a2540 100%);
    color: white;
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-blue::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(251, 191, 36, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .section-amber {
    background: linear-gradient(135deg, #ff6b00 0%, #fbbf24 50%, #f59e0b 100%);
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-amber::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 30% 40%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .section-dark-navy {
    background: linear-gradient(135deg, #0a1f3d 0%, #0a2540 50%, #3b82f6 100%);
    color: white;
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-dark-navy::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 70% 30%, rgba(251, 191, 36, 0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .section-header {
    text-align: center !important;
    margin-bottom: 5rem;
    position: relative;
    z-index: 1;
  }

  .section-header h2 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    margin-bottom: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .section-header p {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    opacity: 0.9;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.5;
    font-weight: 500;
  }

  .section-blue .section-header h2,
  .section-blue .section-header p,
  .section-dark-navy .section-header h2,
  .section-dark-navy .section-header p {
    color: white;
  }

  .section-blue .section-header,
  .section-dark-navy .section-header {
    text-align: center !important;
  }

  .section-blue .section-header p,
  .section-dark-navy .section-header p {
    opacity: 0.95;
  }

  /* Stats Section - BEAUTIFUL BADGES */
  .stats-section {
    background: linear-gradient(135deg, #0a1f3d 0%, #0a2540 50%, #1e3a8a 100%);
    padding: 6rem 0;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .stats-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 50% 50%, rgba(251, 191, 36, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .stat-badge {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 2rem 1.5rem;
    border-radius: 20px;
    border: 2px solid rgba(251, 191, 36, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .stat-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .stat-badge:hover {
    transform: translateY(-8px) scale(1.05);
    border-color: #fbbf24;
    box-shadow: 
      0 20px 60px rgba(251, 191, 36, 0.3),
      0 8px 20px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .stat-badge:hover::before {
    opacity: 1;
  }

  .badge-icon {
    font-size: 3rem;
    filter: drop-shadow(0 4px 12px rgba(251, 191, 36, 0.5));
    transition: transform 0.4s ease;
    line-height: 1;
  }

  .stat-badge:hover .badge-icon {
    transform: scale(1.2) rotateZ(-5deg);
  }

  .badge-content {
    text-align: center;
    width: 100%;
  }

  .badge-number {
    font-size: 2.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 2px 8px rgba(251, 191, 36, 0.3));
  }

  .badge-label {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }

  /* Benefits Grid - DRAMATIC ELEVATION */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .benefit-card {
    background: white;
    padding: 2rem 2.5rem;
    border-radius: 24px;
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.12),
      0 8px 20px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid transparent;
    position: relative;
    overflow: hidden;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #3b82f6, #0a2540);
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .benefit-card:hover::before {
    transform: scaleX(1);
  }

  .benefit-card:hover {
    transform: translateY(-16px) scale(1.02);
    box-shadow: 
      0 30px 80px rgba(0, 0, 0, 0.2),
      0 12px 30px rgba(59, 130, 246, 0.15);
    border-color: #3b82f6;
  }

  .benefit-icon {
    font-size: 3.5rem;
    margin-bottom: 1.25rem;
    display: block;
    line-height: 1;
