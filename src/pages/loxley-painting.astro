---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Loxley Painting', url: '/loxley-painting' }
];
---

<BaseLayout
  title="Painting Services in Loxley, AL | Browns Painting LLC"
  description="Professional painting services in Loxley, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Loxley AL, house painter Loxley Alabama, Baldwin County painting services, interior painting Loxley, exterior painting Loxley"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Loxley AL"
    serviceDescription="Expert painting services in Loxley, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/loxley-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Loxley"
      county="Baldwin County"
      slug="loxley"
      nearbyLinks={[
  { name: 'Bay Minette', url: '/bay-minette-painting' },
  { name: 'Robertsdale', url: '/robertsdale-painting' },
  { name: 'Foley', url: '/foley-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
