---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Flomaton Painting', url: '/flomaton-painting' }
];
---

<BaseLayout
  title="Painting Services in Flomaton, AL | Browns Painting LLC"
  description="Professional painting services in Flomaton, Alabama. Interior, exterior, and commercial painting by Browns Painting — Escambia County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Flomaton AL, house painter Flomaton Alabama, Escambia County painting services, interior painting Flomaton, exterior painting Flomaton"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Flomaton AL"
    serviceDescription="Expert painting services in Flomaton, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/flomaton-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Flomaton"
      county="Escambia County"
      slug="flomaton"
      nearbyLinks={[
  { name: 'Brewton', url: '/brewton-painting' },
  { name: 'Atmore', url: '/atmore-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
