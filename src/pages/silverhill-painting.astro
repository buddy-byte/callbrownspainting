---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Silverhill Painting', url: '/silverhill-painting' }
];
---

<BaseLayout
  title="Painting Services in Silverhill, AL | Browns Painting LLC"
  description="Professional painting services in Silverhill, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Silverhill AL, house painter Silverhill Alabama, Baldwin County painting services, interior painting Silverhill, exterior painting Silverhill"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Silverhill AL"
    serviceDescription="Expert painting services in Silverhill, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/silverhill-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Silverhill"
      county="Baldwin County"
      slug="silverhill"
      nearbyLinks={[
  { name: 'Robertsdale', url: '/robertsdale-painting' },
  { name: 'Foley', url: '/foley-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
