---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Creola Painting', url: '/creola-painting' }
];
---

<BaseLayout
  title="Painting Services in Creola, AL | Browns Painting LLC"
  description="Professional painting services in Creola, Alabama. Interior, exterior, and commercial painting by Browns Painting — Mobile County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Creola AL, house painter Creola Alabama, Mobile County painting services, interior painting Creola, exterior painting Creola"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Creola AL"
    serviceDescription="Expert painting services in Creola, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/creola-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Creola"
      county="Mobile County"
      slug="creola"
      nearbyLinks={[
  { name: 'Mobile', url: '/mobile-painting' },
  { name: 'Saraland', url: '/saraland-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
