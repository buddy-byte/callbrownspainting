---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from '../components/LocationPage.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Service Areas', url: '/service-areas' },
  { label: 'Daphne Painting', url: '/daphne-painting' }
];
---

<BaseLayout
  title="Painting Services in Daphne, AL | Browns Painting LLC"
  description="Professional painting services in Daphne, Alabama. Interior, exterior, and commercial painting by Browns Painting — Baldwin County's trusted painting contractor since 1998. Free estimates."
  keywords="painting contractor Daphne AL, house painter Daphne Alabama, Baldwin County painting services, interior painting Daphne, exterior painting Daphne"
>
  <ServiceSchema
    serviceName="Professional Painting Services in Daphne AL"
    serviceDescription="Expert painting services in Daphne, Alabama by Browns Painting. Interior, exterior, and commercial painting. Licensed and insured."
    serviceUrl="https://callbrownspainting.com/daphne-painting"
    serviceType="Painting Services"
    priceRange="`$$`"
    serviceImage="https://callbrownspainting.com/images/hero/hero-1-optimized.jpg"
  />
  <Breadcrumbs items={breadcrumbItems} />
  <main>
    <LocationPage
      city="Daphne"
      county="Baldwin County"
      slug="daphne"
      nearbyLinks={[
  { name: 'Fairhope', url: '/fairhope-painting' },
  { name: 'Mobile', url: '/mobile-painting' },
  { name: 'Bay Minette', url: '/bay-minette-painting' },
      ]}
    />
    <Testimonials />
  </main>
</BaseLayout>
