---
import SEO from '../components/SEO.astro';
import Navigation from '../components/MobileNavigation.astro';
import Footer from '../components/Footer.astro';
import PerformanceMonitor from '../components/PerformanceMonitor.astro';
import MobilePerformanceMonitor from '../components/MobilePerformanceMonitor.astro';
import CSSLoader from '../components/CSSLoader.astro';
import '../styles/mobile-optimization.css';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, keywords, image, type} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
    />
    
    <!-- Performance optimizations -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    
    <!-- Schema.org structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": [
          "HousePainter",
          "HomeAndConstructionBusiness",
          "LocalBusiness"
        ],
        "@id": "https://callbrownspainting.com/#business",
