        "priceRange": "$$",
        "paymentAccepted": "Cash, Check, Credit Card, Debit Card",
        "currenciesAccepted": "USD",
        "foundingDate": "2018",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Brewton",
          "addressRegion": "AL",
          "postalCode": "36426",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "31.1052",
          "longitude": "-87.0722"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
